FROZEN = getattr(sys, "frozen", False)              # the one-file build
ROOT = Path(getattr(sys, "_MEIPASS", Path(__file__).resolve().parents[1]))     # the shipped files: helix, tools.toml, theme/
EFI_LABEL = "VTOYEFI"            # Ventoy's own small partition: what makes a disk a Ventoy stick
EFI_SIZE = 65536 * 512           # … always 32 MiB


def is_ventoy_efi(part: dict) -> bool:
    """Ventoy's partition: by its name where macOS reads it, else by what it is on an MBR stick,
    an EFI system partition of exactly 32 MiB (macOS doesn't read the name of one of those)."""
    return part.get("VolumeName") == EFI_LABEL or \
        (not part.get("VolumeName") and part.get("Content") in ("0xEF", "EFI") and part.get("Size") == EFI_SIZE)


def load_helix():
    loader = importlib.machinery.SourceFileLoader("helix", str(ROOT / "helix"))
    spec = importlib.util.spec_from_loader("helix", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


cr = load_helix()


def user_dir() -> Path:
    """Your files: local.toml and byo/, beside the program (or the repo, run from source)."""
    return Path(sys.executable).resolve().parent if FROZEN else ROOT


def user_folder() -> Path:
    """user_dir(), with a byo/ in it when this is the one-file program (nothing unpacked one for you)."""
    mine = user_dir()
    if FROZEN:
        try:
            (mine / "byo").mkdir(exist_ok=True)
        except OSError:
            pass
    return mine


def config():
    return cr.Config(repo=user_folder(), assets=ROOT)


def diskutil(*args: str) -> dict:
    """`diskutil … -plist`, as a dict. Raises RescueError with what diskutil said."""
    try:
        r = subprocess.run(["diskutil", *args], capture_output=True, timeout=120)
    except FileNotFoundError:
        raise cr.RescueError("diskutil isn't here: this runs on macOS") from None
    except subprocess.TimeoutExpired:
        raise cr.RescueError("diskutil didn't answer within 2 minutes") from None
    if r.returncode:
        said = (r.stderr or r.stdout).decode("utf-8", "replace").strip()
        raise cr.RescueError(f"diskutil {' '.join(args)}: {said[:300]}")
    try:
        return plistlib.loads(r.stdout) if "-plist" in args else {}
    except (plistlib.InvalidFileException, ValueError):
        raise cr.RescueError(f"diskutil {' '.join(args)} gave something that isn't a property list") from None


def sticks(run=diskutil) -> list[dict]:
    """The Ventoy sticks plugged in: disks that aren't inside the Mac and have Ventoy's VTOYEFI
    partition. The data partition is the one named Ventoy or, since people rename it, the
    biggest other one."""
    found = []
    for d in run("list", "-plist").get("AllDisksAndPartitions", []):
        parts = [p for p in d.get("Partitions", []) if p.get("DeviceIdentifier")]
        efi = next((p for p in parts if is_ventoy_efi(p)), None)
        rest = [p for p in parts if p is not efi]
        if not efi or not rest:
            continue
        info = run("info", "-plist", d["DeviceIdentifier"])
        if info.get("Internal") or info.get("SystemImage"):          # never a disk inside the Mac
            continue
        data = next((p for p in rest if p.get("VolumeName") == "Ventoy"), max(rest, key=lambda p: p.get("Size", 0)))
        found.append({"disk": d["DeviceIdentifier"], "name": str(info.get("MediaName") or info.get("IORegistryEntryName") or "disk"),
                      "size": int(info.get("TotalSize") or info.get("Size") or d.get("Size") or 0),
                      "bus": str(info.get("BusProtocol") or ""), "data": data["DeviceIdentifier"],
                      "label": str(data.get("VolumeName") or ""), "efi": efi["DeviceIdentifier"]})
    return found


def pick(disk: str | None, run=diskutil) -> dict:
    found = sticks(run)
    if disk:
        disk = disk.removeprefix("/dev/")
        hit = next((s for s in found if s["disk"] == disk), None)
        if not hit:
            raise cr.RescueError(f"{disk} isn't a Helix Boot / Ventoy stick (an external disk with a {EFI_LABEL} partition)")
        return hit
    if not found:
        raise cr.RescueError("no Helix Boot / Ventoy stick found. Plug it in, or name it with --disk disk4.")
    if len(found) > 1:
        raise cr.RescueError("more than one stick is plugged in (" + ", ".join(s["disk"] for s in found)
                             + "): name the one you mean with --disk")
    return found[0]


def mount(part: str, run=diskutil) -> Path:
    """Where a partition is mounted, mounting it if it isn't."""
    where = run("info", "-plist", part).get("MountPoint")
    if not where:
        run("mount", part)
        where = run("info", "-plist", part).get("MountPoint")
    if not where:
        raise cr.RescueError(f"couldn't mount {part}")
    return Path(where)


def same_stick(stick: dict, mnt: Path, run=diskutil) -> None:
    """Before a write: the folder is still that stick's data partition, and the disk is still it."""
    now = run("info", "-plist", str(mnt))
    disk = run("info", "-plist", stick["disk"])
    size = int(disk.get("TotalSize") or disk.get("Size") or 0)
    if now.get("DeviceIdentifier") != stick["data"] or disk.get("Internal") or size != stick["size"]:
        raise cr.RescueError("the stick was unplugged or replaced; start again")


def human(size: int) -> str:
    return f"{size / 1000**3:.0f} GB" if size >= 10 * 1000**3 else f"{size / 1000**3:.1f} GB"


def ns(**kw):
    return argparse.Namespace(**kw)


def sudo(*cmd: str) -> None:
    """Run one command as root (it asks for your password in the terminal the first time)."""
    r = subprocess.run(["sudo", *cmd], capture_output=True, text=True)
    if r.returncode:
        raise cr.RescueError(f"{cmd[0]} failed: {(r.stderr or r.stdout).strip()[-300:]}")


def boot_script(cfg, stick: dict, mnt: Path, run=diskutil, root=sudo) -> None:
    """The splash and the L / F1 keys, in Ventoy's own boot script (as install.sh and refresh.sh
    add on Linux). Never fatal: a stick it can't be done on starts as Ventoy does.

    Ventoy's partition is an EFI system partition, which diskutil won't mount from an MBR disk
    (as most sticks are), so it is then mounted directly as the FAT volume it is. That needs
    root, hence the password."""
    was = run("info", "-plist", stick["efi"]).get("MountPoint")
    direct = None
    try:
        try:
            efi = mount(stick["efi"], run)
        except cr.RescueError:
            direct = efi = Path(tempfile.mkdtemp(prefix="helix-vtoyefi-"))
            root("mount_msdos", "-u", str(os.getuid()), "-g", str(os.getgid()), f"/dev/{stick['efi']}", str(efi))
        if cr.cmd_splash(cfg, ns(efi=str(efi), remove=False, dry_run=False, stick=str(mnt))):
            raise cr.RescueError("Ventoy's boot script couldn't be changed")
    except (cr.RescueError, OSError) as e:
        cr.warn(f"no splash, and L and F1 stay Ventoy's Language and Help: {e}")
        try:
            cr.forget_keys_hook(cfg, mnt)
        except (cr.RescueError, OSError):
            pass
    finally:
        try:
            if direct:
                try:
                    root("umount", str(direct))
                finally:
                    try:
                        direct.rmdir()
                    except OSError:
                        pass
            elif not was:
                run("unmount", stick["efi"])
        except cr.RescueError:
            pass


def update(a, run=diskutil, ask=input) -> int:
    cfg = config()
    stick = pick(a.disk, run)
    mnt = mount(stick["data"], run)
    cr.ok(f"Stick: {stick['disk']} ({stick['name']}, {human(stick['size'])}) at {mnt}")
    if not a.pack and not a.no_fetch:
        if cr.cmd_fetch(cfg, ns(tools=[], force=False)):
            cr.warn("some downloads failed; updating with everything else")
    same_stick(stick, mnt, run)
    # (init=True below: this disk was just checked to be a Ventoy stick, whatever it has been named)
    summary = cr.plan_text(cr.update_plan(cfg, str(mnt), a.pack, prune_unknown=a.prune_unknown, init=True,
                                          verify=a.verify))
    print(f"\nThis update will:\n{summary}\n")
    nothing = summary.startswith("Everything on the stick is already up to date")
    if not a.yes and not nothing and ask("Go ahead? [y/N] ").strip().lower() not in ("y", "yes"):
        raise cr.RescueError("stopped: nothing on the stick was changed")
    same_stick(stick, mnt, run)
    common = dict(target=str(mnt), init=True, dry_run=False, verify=a.verify, no_prune=False, prune_unknown=a.prune_unknown)
    rc = cr.cmd_unpack(cfg, ns(pack=a.pack, **common)) if a.pack else cr.cmd_sync(cfg, ns(**common))
    if rc:
        return rc
    # Spotlight would index the stick and leave its folders on it; this asks it not to
    try:
        (mnt / ".metadata_never_index").touch()
    except OSError:
        pass
    same_stick(stick, mnt, run)
    boot_script(cfg, stick, mnt, run)
    if a.eject:
        run("eject", stick["disk"])
        cr.ok("Ejected: safe to unplug.")
    return 0


# ── A new stick (experimental) ─────────────────────────────────────────────
ERASABLE_BUSES = {"USB", "Secure Digital"}
BIG_DISK = 300 * 1000**3


def write_disk(disk: str, src: Path, *where: str, run=diskutil, root=sudo, tries: int = 6) -> None:
    """dd a file onto the disk. macOS keeps hold of a disk for a moment after it is unmounted
    ("Resource busy"), so this unmounts and tries again; if the raw device stays busy, the
    buffered one is used."""
    said = ""
    for n in range(tries):
        dev = f"/dev/r{disk}" if n < tries - 2 else f"/dev/{disk}"
        try:
            run("unmountDisk", "force", disk)
            root("dd", f"if={src}", f"of={dev}", *where)
            return
        except cr.RescueError as e:
            said = str(e)
            if "busy" not in said.lower():
                raise
            time.sleep(2)
    raise cr.RescueError(f"{disk} stayed busy ({said}). Close anything using it, or unplug it and plug it in again.")


def partitions_seen(disk: str, *parts: str, run=diskutil, tries: int = 30) -> None:
    """Wait until macOS has read the disk's partition table and answers for each partition:
    after a write to the table they are gone for a moment."""
    for _ in range(tries):
        try:
            names = {p.get("DeviceIdentifier") for d in run("list", "-plist", disk).get("AllDisksAndPartitions", [])
                     for p in d.get("Partitions", [])}
            if set(parts) <= names:
                for part in parts:
                    run("info", "-plist", part)
                return
        except cr.RescueError:
            pass
        time.sleep(1)
    raise cr.RescueError(f"macOS doesn't see the new partitions on {disk}; unplug it, plug it in and try again")


def erasable(disk: str, run=diskutil, disk_images: bool = False) -> dict:
    """The disk to erase, if it may be: a whole USB or SD disk that isn't inside the Mac and
    holds nothing the Mac is running from. Raises RescueError otherwise."""
    if not re.fullmatch(r"disk\d+", disk):
        raise cr.RescueError("install needs a whole disk, named like disk4 (see `diskutil list external`)")
    info = run("info", "-plist", disk)
    if not info or not info.get("WholeDisk", True):
        raise cr.RescueError(f"{disk} isn't a whole disk")
    bus = str(info.get("BusProtocol") or "")
    if info.get("Internal") or info.get("SystemImage"):
        raise cr.RescueError(f"{disk} is inside this Mac. Refusing.")
    if bus not in ERASABLE_BUSES and not (disk_images and bus == "Disk Image"):
        raise cr.RescueError(f"{disk} isn't a USB or SD disk (it is on {bus or 'an unknown bus'}). Refusing.")
    for d in run("list", "-plist", disk).get("AllDisksAndPartitions", []):
        for part in d.get("Partitions", []):
            where = str(run("info", "-plist", part.get("DeviceIdentifier", "")).get("MountPoint") or "")
            if where == "/" or where.startswith(("/System", "/private")):
                raise cr.RescueError(f"{disk} holds part of the running system ({where}). Refusing.")
    size = int(info.get("TotalSize") or info.get("Size") or 0)
    if size <= 0:
        raise cr.RescueError(f"can't tell how big {disk} is")
    return {"disk": disk, "name": str(info.get("MediaName") or info.get("IORegistryEntryName") or "disk"),
            "size": size, "bus": bus}


def install(a, run=diskutil, ask=input, root=sudo) -> int:
    """Erase a USB disk and make it a Helix Boot stick: Ventoy's layout written directly (see
    ventoy_layout in the engine), the data partition formatted by macOS, then filled as an
    update fills it."""
    cfg = config()
    disk = (a.disk or "").removeprefix("/dev/")
    target = erasable(disk, run, a.allow_disk_image)
    # Everything is fetched and checked before the disk is touched
    if a.pack:
        vdir = cr._ventoy_from_pack(cfg, a.pack, windows=False)
    else:
        if not a.no_fetch and cr.cmd_fetch(cfg, ns(tools=[], force=False)):
            cr.warn("some downloads failed; the stick gets everything else")
        entry = cr.load_lock(cfg).get("ventoy")
        vdir = cfg.cache / "ventoy" / entry["final"] if entry else None
        if not vdir or not (vdir / "boot" / "boot.img").is_file():
            raise cr.RescueError("Ventoy isn't downloaded: check your connection and try again")
    layout = cr.ventoy_layout(vdir, target["size"] // 512)

    cr.head("This will ERASE everything on:")
    print(f"  {disk}: {target['name']}, {human(target['size'])}, {target['bus']}")
    if target["size"] >= BIG_DISK:
        cr.warn("this disk is bigger than most sticks. Is it an external drive with backups?")
    print("  Installing from a Mac is experimental: Ventoy's layout is written directly.\n")
    if a.erase != disk and ask(f"Type {disk} to erase it: ").strip() != disk:
        raise cr.RescueError("didn't match: nothing was changed")
    if erasable(disk, run, a.allow_disk_image) != target:
        raise cr.RescueError("the disk was unplugged or replaced; start again")

    work = Path(tempfile.mkdtemp(prefix="helix-install-"))
    try:
        (work / "head.bin").write_bytes(layout["head"])
        (work / "efi.img").write_bytes(layout["efi"])
        part1, part2 = f"{disk}s1", f"{disk}s2"
        cr.info("writing Ventoy …")
        write_disk(disk, work / "head.bin", "bs=1m", run=run, root=root)
        write_disk(disk, work / "efi.img", "bs=4096", f"seek={layout['efi_start'] // 8}", run=run, root=root)
        root("sync")
        partitions_seen(disk, part1, part2, run=run)
        cr.info("formatting the data partition …")
        run("eraseVolume", "ExFAT", cfg.stick_label, part1)
        (work / "sector0.bin").write_bytes(layout["head"][:512])    # formatting may touch the table: ours again
        write_disk(disk, work / "sector0.bin", "bs=512", "count=1", run=run, root=root)
        root("sync")
        partitions_seen(disk, part1, part2, run=run)     # the table was written again: read again
    finally:
        for f in work.glob("*"):
            f.unlink()
        work.rmdir()

    stick = {"disk": disk, "name": target["name"], "size": target["size"], "bus": target["bus"],
             "data": part1, "label": cfg.stick_label, "efi": part2}
    mnt = mount(part1, run)
    cr.ok(f"Ventoy written, stick mounted at {mnt}")
    same_stick(stick, mnt, run)
    if getattr(a, "test", False):
        cr.head(f"Testing {disk}: writes it full and reads it back, so this takes a while")
        found = cr.test_stick(mnt)
        print(cr.test_text(found))
        if found["bad"] or found["error"] or not found["written"]:
            raise cr.RescueError(f"{disk} failed the test: it is left empty. Use another stick.")
        same_stick(stick, mnt, run)
    common = dict(target=str(mnt), init=True, dry_run=False, verify=True, no_prune=False, prune_unknown=False)
    rc = cr.cmd_unpack(cfg, ns(pack=a.pack, **common)) if a.pack else cr.cmd_sync(cfg, ns(**common))
    if rc:
        return rc
    try:
        (mnt / ".metadata_never_index").touch()
    except OSError:
        pass
    same_stick(stick, mnt, run)
    boot_script(cfg, stick, mnt, run, root)
    if a.eject:
        run("eject", disk)
        cr.ok("Ejected: safe to unplug.")
    cr.ok("Done. On a Secure Boot PC, the first boot asks to enrol Ventoy's key (Enroll key, then reboot).")
    return 0


def engine(argv: list[str]) -> int:
    """Run the engine's own command line, with your folder as it is here."""
    os.environ["HELIX_USER_DIR"] = str(user_folder())
    return cr.main(argv)


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(prog="helix-mac", description=__doc__.split("\n\n")[0],
                                 epilog="`helix-mac look` takes the options of `helix theme`: --theme, --icons, "
                                        "--background, --dim, --splash, --reset, --menu, --preview, --export, --import.")
    sub = ap.add_subparsers(dest="cmd", metavar="command")

    def stick_arg(p):
        p.add_argument("--disk", metavar="diskN", help="the stick, if more than one is plugged in (see `list`)")

    p = sub.add_parser("update", help="update the stick: newer tools, the menu, the splash (the default)")
    stick_arg(p)
    p.add_argument("--from", dest="pack", metavar="PACK", help="copy from a pack .zip, with no downloads")
    p.add_argument("--no-fetch", action="store_true", help="don't download: use what's already fetched")
    p.add_argument("--verify", action="store_true", help="re-read every file on the stick after copying (slow)")
    p.add_argument("--prune-unknown", action="store_true",
                   help="also remove tools on the stick that this Mac has no copy of (by default they stay)")
    p.add_argument("--yes", action="store_true", help="don't ask before changing the stick")
    p.add_argument("--eject", action="store_true", help="eject the stick when finished")
    p = sub.add_parser("install", help="EXPERIMENTAL: erase a USB disk and make a new stick")
    p.add_argument("--disk", metavar="diskN", required=True, help="the whole disk to erase (see `diskutil list external`)")
    p.add_argument("--from", dest="pack", metavar="PACK", help="fill it from a pack .zip, with no downloads")
    p.add_argument("--no-fetch", action="store_true", help="don't download: use what's already fetched")
    p.add_argument("--erase", metavar="diskN", help="confirm the erase here (the disk's name again) and don't ask")
    p.add_argument("--test", action="store_true",
                   help="test the stick before filling it: write it full and read it back (slow)")
    p.add_argument("--eject", action="store_true", help="eject the stick when finished")
    p.add_argument("--allow-disk-image", action="store_true", help=argparse.SUPPRESS)   # for the test in CI
    p = sub.add_parser("check", help="read the stick back and find damaged or missing files")
    stick_arg(p)
    p = sub.add_parser("look", help="show or change the stick's look", add_help=False)
    p = sub.add_parser("list", help="the Helix Boot / Ventoy sticks plugged in")
    p = sub.add_parser("helix", help="the engine itself: helix list, check, fetch, pack …", add_help=False)
    if argv is None:
        argv = sys.argv[1:]
    if not argv or argv[0].startswith("-") and argv[0] not in ("-h", "--help"):
        argv = ["update", *argv]
    try:
        if argv[0] == "look":                        # its options go to `helix theme` as they are
            lp = argparse.ArgumentParser(prog="helix-mac look", add_help=False)
            stick_arg(lp)
            mine, theme_args = lp.parse_known_args(argv[1:])
            mnt = mount(pick(mine.disk)["data"])
            return engine(["theme", str(mnt), *theme_args])
        if argv[0] == "helix":                       # the engine itself: helix-mac helix fetch ventoy …
            return engine(argv[1:])
        a = ap.parse_args(argv)
        if a.cmd == "list":
            found = sticks()
            for s in found:
                print(f"{s['disk']}  {s['name']}  {human(s['size'])}  {s['bus']}  ({s['label'] or 'unnamed'})")
            if not found:
                print("No Helix Boot / Ventoy stick found.")
            return 0
        if a.cmd == "install":
            return install(a)
        if a.cmd == "check":
            mnt = mount(pick(a.disk)["data"])
            return cr.cmd_verify(config(), ns(target=str(mnt), json=False))
        return update(a)
    except cr.RescueError as e:
        cr.bad(str(e))
        return 1
    except KeyboardInterrupt:
        print()
        cr.bad("stopped")
        return 130


if __name__ == "__main__":
    sys.exit(main())
