[License]
// Commander Rescue - PhoenixPE add-on (MIT).
// Puts the Commander Rescue app launcher inside the PE with desktop and Start
// menu shortcuts. The apps themselves stay on the USB in Apps\ and are updated
// from Linux by refresh.sh, so this never needs changing when they do.
//
// Installed into Projects\MyApps\Commander Rescue\ by Apply-CommanderPreset.ps1,
// next to a copy of CommanderApps.cmd.

[Main]
Title=Commander Rescue
Description=Launcher for the portable apps on the Commander Rescue USB (Apps\CommanderApps.cmd).
Author=Commander Rescue
Level=5
Selected=True
Mandatory=False
Version=1.0.0.0
Date=2026-09-26

[Variables]
%ProgramFolder%="Commander Rescue"
%ProgramExe%="CommanderApps.cmd"

[Process]
Echo,"Processing %ScriptTitle%..."

StrFormat,DirPath,%ScriptFile%,%SrcDir%
If,Not,ExistFile,"%SrcDir%%ProgramExe%",Halt,"%ProgramExe% is missing next to %ScriptFile%. Re-run Apply-CommanderPreset.ps1."

DirMake,"%TargetPrograms%\%ProgramFolder%"
FileCopy,"%SrcDir%%ProgramExe%","%TargetPrograms%\%ProgramFolder%"

If,%cb_DesktopShc%,Equal,True,AddShortcut,Desktop,"",%txt_ShortcutName%,"%PEPrograms%\%ProgramFolder%\%ProgramExe%","","%PEPrograms%\%ProgramFolder%"
If,%cb_StartMenuShc%,Equal,True,AddShortcut,StartMenu,%txt_StartMenuFolder%,%txt_ShortcutName%,"%PEPrograms%\%ProgramFolder%\%ProgramExe%","","%PEPrograms%\%ProgramFolder%"

[Interface]
lbl_About="Adds the Commander Rescue app launcher. It finds the USB by commander-rescue.tag and runs apps from USB:\Apps.",1,1,10,10,600,20,8,Normal
cb_DesktopShc=Desktop,1,3,10,40,200,18,True
cb_StartMenuShc="Start Menu",1,3,10,62,200,18,True
txt_StartMenuFolder="Start Menu Folder:",1,0,10,100,200,21,"System Tools"
txt_ShortcutName="Shortcut Name:",1,0,10,142,200,21,"Commander Apps"
