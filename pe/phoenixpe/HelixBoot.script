[License]
// Helix Boot - PhoenixPE add-on (MIT).
// Puts the Helix Boot app launcher inside the PE with desktop and Start
// menu shortcuts. The apps themselves stay on the USB in Apps\ and are updated
// from Linux by refresh.sh, so this never needs changing when they do.
// Also starts the PortableApps.com Platform from the USB when the desktop loads,
// and gives the Start menu the profile picture next to this script (AccountPictures\).
//
// Installed into Projects\MyApps\Helix Boot\ by Apply-HelixPreset.ps1,
// next to a copy of HelixApps.cmd.

[Main]
Title=Helix Boot
Description=Launcher for the portable apps on the Helix Boot USB (Apps\HelixApps.cmd).
Author=Helix Boot
Level=5
Selected=True
Mandatory=False
Version=1.2.0.0
Date=2026-09-29

[Variables]
%ProgramFolder%="Helix Boot"
%ProgramExe%="HelixApps.cmd"
%PAHelper%="StartPortableApps.cmd"

[Process]
Echo,"Processing %ScriptTitle%..."

StrFormat,DirPath,%ScriptFile%,%SrcDir%
If,Not,ExistFile,"%SrcDir%%ProgramExe%",Halt,"%ProgramExe% is missing next to %ScriptFile%. Re-run Apply-HelixPreset.ps1."

If,Not,ExistFile,"%SrcDir%%PAHelper%",Halt,"%PAHelper% is missing next to %ScriptFile%. Re-run Apply-HelixPreset.ps1."

DirMake,"%TargetPrograms%\%ProgramFolder%"
FileCopy,"%SrcDir%%ProgramExe%","%TargetPrograms%\%ProgramFolder%"
FileCopy,"%SrcDir%%PAHelper%","%TargetPrograms%\%ProgramFolder%"

// PortableApps.com Platform on the USB (X:\Start.exe): open it with the desktop
If,%cb_AutoPortableApps%,Equal,True,AddAutoRun,PostShell,HideNoWait,"","%PEPrograms%\%ProgramFolder%\%PAHelper%"
If,%cb_PortableAppsShc%,Equal,True,AddShortcut,Desktop,"","PortableApps","%PEPrograms%\%ProgramFolder%\%PAHelper%","","%PEPrograms%\%ProgramFolder%","","","Minimized"

If,%cb_DesktopShc%,Equal,True,AddShortcut,Desktop,"",%txt_ShortcutName%,"%PEPrograms%\%ProgramFolder%\%ProgramExe%","","%PEPrograms%\%ProgramFolder%"
If,%cb_StartMenuShc%,Equal,True,AddShortcut,StartMenu,%txt_StartMenuFolder%,%txt_ShortcutName%,"%PEPrograms%\%ProgramFolder%\%ProgramExe%","","%PEPrograms%\%ProgramFolder%"

If,%cb_ProfilePic%,Equal,True,Begin
  If,ExistDir,"%SrcDir%AccountPictures",Run,%ScriptFile%,ProfilePic
  Else,Echo,"No AccountPictures folder next to %ScriptFile%: keeping the default profile picture.",Warn
End

[ProfilePic]
// StartAllBack takes the picture from Windows' own per-user list,
// HKLM\...\AccountPicture\Users\<SID>\Image<size>. Everything in the PE runs as SYSTEM (S-1-5-18).
// The sizes are made ahead of time (AccountPictures\Image<size>.png), so nothing is converted here.
Echo,"Setting the Start menu profile picture..."
DirMake,"%TargetDir%\Users\Public\AccountPictures\S-1-5-18"
FileCopy,"%SrcDir%AccountPictures\*.png","%TargetDir%\Users\Public\AccountPictures\S-1-5-18"
RegLoadHives
RegWrite,HKLM,REG_SZ,"Tmp_Software\Microsoft\Windows\CurrentVersion\AccountPicture\Users\S-1-5-18","Image32","X:\Users\Public\AccountPictures\S-1-5-18\Image32.png"
RegWrite,HKLM,REG_SZ,"Tmp_Software\Microsoft\Windows\CurrentVersion\AccountPicture\Users\S-1-5-18","Image40","X:\Users\Public\AccountPictures\S-1-5-18\Image40.png"
RegWrite,HKLM,REG_SZ,"Tmp_Software\Microsoft\Windows\CurrentVersion\AccountPicture\Users\S-1-5-18","Image48","X:\Users\Public\AccountPictures\S-1-5-18\Image48.png"
RegWrite,HKLM,REG_SZ,"Tmp_Software\Microsoft\Windows\CurrentVersion\AccountPicture\Users\S-1-5-18","Image64","X:\Users\Public\AccountPictures\S-1-5-18\Image64.png"
RegWrite,HKLM,REG_SZ,"Tmp_Software\Microsoft\Windows\CurrentVersion\AccountPicture\Users\S-1-5-18","Image96","X:\Users\Public\AccountPictures\S-1-5-18\Image96.png"
RegWrite,HKLM,REG_SZ,"Tmp_Software\Microsoft\Windows\CurrentVersion\AccountPicture\Users\S-1-5-18","Image192","X:\Users\Public\AccountPictures\S-1-5-18\Image192.png"
RegWrite,HKLM,REG_SZ,"Tmp_Software\Microsoft\Windows\CurrentVersion\AccountPicture\Users\S-1-5-18","Image208","X:\Users\Public\AccountPictures\S-1-5-18\Image208.png"
RegWrite,HKLM,REG_SZ,"Tmp_Software\Microsoft\Windows\CurrentVersion\AccountPicture\Users\S-1-5-18","Image240","X:\Users\Public\AccountPictures\S-1-5-18\Image240.png"
RegWrite,HKLM,REG_SZ,"Tmp_Software\Microsoft\Windows\CurrentVersion\AccountPicture\Users\S-1-5-18","Image424","X:\Users\Public\AccountPictures\S-1-5-18\Image424.png"
RegWrite,HKLM,REG_SZ,"Tmp_Software\Microsoft\Windows\CurrentVersion\AccountPicture\Users\S-1-5-18","Image448","X:\Users\Public\AccountPictures\S-1-5-18\Image448.png"
RegUnLoadHives

[Interface]
lbl_About="Adds the Helix Boot app launcher. It finds the USB by helix-boot.tag and runs apps from USB:\Apps.",1,1,10,10,600,20,8,Normal
cb_DesktopShc=Desktop,1,3,10,40,200,18,True
cb_StartMenuShc="Start Menu",1,3,10,62,200,18,True
txt_StartMenuFolder="Start Menu Folder:",1,0,10,100,200,21,"System Tools"
txt_ShortcutName="Shortcut Name:",1,0,10,142,200,21,"Helix Apps"
cb_AutoPortableApps="Start PortableApps.com with the desktop",1,3,10,184,300,18,True
cb_PortableAppsShc="PortableApps desktop shortcut",1,3,10,206,300,18,True
cb_ProfilePic="Start menu profile picture (AccountPictures next to this script)",1,3,10,228,400,18,True
