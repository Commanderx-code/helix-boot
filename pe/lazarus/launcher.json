{
  "_about": "Lazarus launcher settings. Categories are shown in this order; each tool goes to the first rule whose pattern matches its name, folder or description (case-insensitive regular expressions), then by its PortableApps.com or Start menu category, else to the default. Icons are Material Design Icons path data (see LICENSE-icons.txt).",
  "title": "Lazarus",
  "title_accent": "PE",
  "subtitle": "Windows PE Recovery Environment",
  "fullscreen": true,
  "tagline": [
    "RESTORE",
    "REBUILD",
    "RISE AGAIN"
  ],
  "side_note": [
    "SYSTEMS TODAY",
    "SECOND CHANCES",
    "TOMORROW"
  ],
  "quote": [
    "A broken system is not the end…",
    "…it's a new beginning."
  ],
  "categories": [
    {
      "id": "recovery",
      "title": "Recovery",
      "subtitle": "Repair and restore your system",
      "icon": "restore",
      "header": "Recovery Tools",
      "tagline": "Get your system back up and running"
    },
    {
      "id": "backup",
      "title": "Backup",
      "subtitle": "Create and manage backups",
      "icon": "database",
      "header": "Backup Tools",
      "tagline": "Images, clones and copies of your data"
    },
    {
      "id": "disk",
      "title": "Disk Tools",
      "subtitle": "Partition, format and disk utilities",
      "icon": "harddisk",
      "header": "Disk Tools",
      "tagline": "Partitions, space, imaging and wiping"
    },
    {
      "id": "diagnostics",
      "title": "Diagnostics",
      "subtitle": "Test hardware and system health",
      "icon": "monitor-dashboard",
      "header": "Diagnostics",
      "tagline": "Health, sensors and benchmarks"
    },
    {
      "id": "network",
      "title": "Network",
      "subtitle": "Network tools and configuration",
      "icon": "web",
      "header": "Network Tools",
      "tagline": "Get online, reach other machines"
    },
    {
      "id": "security",
      "title": "Security",
      "subtitle": "Remove malware and secure your system",
      "icon": "shield-check",
      "header": "Security Tools",
      "tagline": "Scan, clean and recover access"
    },
    {
      "id": "utilities",
      "title": "Utilities",
      "subtitle": "Additional tools and features",
      "icon": "cog",
      "header": "Utilities",
      "tagline": "Everything else on this stick",
      "default": true
    }
  ],
  "rules": [
    {
      "category": "utilities",
      "match": "unlocker|registry cleaner|uninstaller|force deleter|duplicate finder|disk cleaner|junk"
    },
    {
      "category": "recovery",
      "match": "recover|undelete|photorec|testdisk|r-studio|\\brcv|recuva|\\bdrw\\b|data rescue|dism\\+\\+|\\bbcd|boot ?repair|startup repair|lockpick|ntpwedit|recovery environment"
    },
    {
      "category": "backup",
      "match": "backup|disk imag|system imag|imaging|\\bclone|clonezilla|macrium|wintohdd|fastcopy|teracopy"
    },
    {
      "category": "diagnostics",
      "match": "crystaldisk|hwinfo|hwmonitor|cpu-?z|gpu-?z|ssd-?z|pci-?z|aida|speccy|\\bspec\\b|coreinfo|stress|benchmark|whynotwin11|cpufrequenz|crystalmark|hdhacker|diskmon|sensor|memtest|memory diagnostic|system information|produkey|sysinternals|process explorer|process hacker|processko|autoruns|rammap|vmmap|task manager|detect ?it ?easy|\\.net ?inspector|error ?lookup"
    },
    {
      "category": "security",
      "match": "malware|virus|antivirus|emsisoft|kaspersky|kvrt|msert|safety scanner|hitmanpro|stinger|spybot|clamwin|hijackthis|keepass|password|pwgen|veracrypt|peerblock|shutup|privazer"
    },
    {
      "category": "network",
      "match": "network|\\bip\\b|\\bip scanner|putty|kitty|teamviewer|anydesk|rustdesk|filezilla|winscp|tcpview|whodat|browser|firefox|chrome|chromium|brave|qbittorrent|hexchat|dyndns|penetwork|wi-?fi|kudu"
    },
    {
      "category": "disk",
      "match": "disk|partition|defrag|wiztree|windirstat|rufus|eraser|ultraiso|yumi|etcher|diskgenius|gparted|\\bformat|\\bdfg\\b|wipe|drive space"
    }
  ],
  "portableapps_categories": {
    "Security": "security",
    "Internet": "network"
  },
  "startmenu_folders": {
    "Backup & Imaging": "backup",
    "Benchmarking": "diagnostics",
    "Diagnostics & Repair": "recovery",
    "Disk Management": "disk",
    "File Management": "utilities",
    "File Recovery": "recovery",
    "Malware Removal": "security",
    "Networking": "network",
    "Password Recovery": "security",
    "System Information": "diagnostics",
    "System Tools": "utilities",
    "Accessories": "utilities"
  },
  "rename": {
    "ccPortable": "CCleaner",
    "dfgPortable": "Defraggler",
    "rcvPortable": "Recuva",
    "specPortable": "Speccy",
    "mssPortable": "Microsoft Safety Scanner"
  },
  "hide": [
    "^portableapps\\.com$",
    "^commonfiles$",
    "^accessibility$",
    "^startup$",
    "helix apps",
    "^portableapps$",
    "uninstall",
    "readme",
    "help$",
    "^website$"
  ],
  "quick": [
    {
      "title": "Command Prompt",
      "icon": "console",
      "run": "cmd.exe"
    },
    {
      "title": "File Explorer",
      "icon": "folder-open",
      "run": "explorer.exe"
    },
    {
      "title": "Device Manager",
      "icon": "chip",
      "run": "mmc.exe",
      "args": "devmgmt.msc"
    },
    {
      "title": "PortableApps",
      "icon": "apps",
      "run": "{stick}\\Start.exe"
    },
    {
      "title": "Reboot",
      "icon": "restart",
      "action": "reboot"
    },
    {
      "title": "Shutdown",
      "icon": "power",
      "action": "shutdown"
    }
  ],
