GITHUB_API = os.environ.get("CRESCUE_GITHUB_API", "https://api.github.com")
SF_RSS = os.environ.get(
    "CRESCUE_SF_RSS", "https://sourceforge.net/projects/{project}/rss?path={path}"  # SourceForge rejects limit > 100
)
SF_DL = os.environ.get("CRESCUE_SF_DL", "https://downloads.sourceforge.net/project/{project}{path}")
USER_AGENT = f"commander-rescue/{__version__} (+https://github.com/Commanderx-code/commander-rescue)"
# For the few sites that turn away anything but a browser (`user_agent = "browser"` on a tool)
BROWSER_UA = "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:140.0) Gecko/20100101 Firefox/140.0"
KINDS = {"iso", "app", "ventoy", "file", "tree"}
SOURCES = {"github": ["repo"], "sourceforge": ["project", "path"], "url": ["url"], "page": ["page", "asset", "version"],
           "local": ["path"]}
HASH_BY_LEN = {32: "md5", 40: "sha1", 64: "sha256", 128: "sha512"}
STRENGTH = {"md5": 1, "sha1": 2, "sha256": 3, "sha512": 4}
STATE_DIR = ".commander-rescue"
TAG_FILE = "commander-rescue.tag"
# Category ids from before the MediCat-style menu; local.toml entries using them keep working.
