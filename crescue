#!/usr/bin/env python3
"""crescue — build and refresh the Commander Rescue USB.

Resolves the newest upstream release of every tool in tools.toml, downloads and
verifies it into a local cache, then syncs the cache onto a Ventoy stick with a
generated boot menu. Standard library only (Python 3.11+).
"""
