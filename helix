def _mac_readme(cfg: Config, apps: list[tuple]) -> bytes | None:
    """Mac/README.txt: what each Mac tool is, and how to open it."""
    mac = [(t, src) for t, _, src in apps if t.get("platform") == "mac"]
    if not mac:
        return None
    lines = ["Helix Boot: tools for a Mac", "===========================", "",
             "These run on a working Mac; nothing here boots one. Copy a tool's folder to the Mac",
             "first (the Desktop will do), then open the file in it: a .dmg or .pkg opens with a",
             "double-click, a .zip unpacks to the app. If macOS won't open an app because it can't",
             "check its developer, allow it under System Settings > Privacy & Security (Open Anyway);",
             "on macOS 14 and older, right-clicking the app and choosing Open does the same.", ""]
    for t, src in sorted(mac, key=lambda ts: ts[0]["title"].lower()):
        lines += [f"{t['title']}", f"    {t['name']}/{src.name}"]
        lines += [f"    {t['description']}"] if t.get("description") else []
        if t.get("macos"):          # "14.0" reads better as 14; "15.6" and "10.13" stay
            oldest = re.sub(r"(?<=\d{2})\.0$", "", t["macos"])
            lines += [f"    Needs macOS {oldest} or newer"]
        lines += [""]
    return "\n".join(lines).encode("utf-8")


def _trees(cfg: Config, lock: dict) -> list[tuple[dict, dict, Path]]:
    """Fetched `kind = "tree"` tools: (tool, lock entry, folder). A local tree is a folder as is."""
    out = []
    for t in cfg.enabled(kinds={"tree"}):
        entry = lock.get(t["name"])
        src = (Path(entry["path"]) if entry and entry.get("path")
               else cfg.cache / t["name"] / entry["final"] if entry and entry.get("final") else None)
        if src and src.is_dir():
            out.append((t, entry, src))
        else:
            warn(f"{t['title']}: not fetched yet — run `helix fetch` (skipping)")
    return out


PA_MARK = b"Helix Boot: restyled"     # in every image we write, so a patched file is recognised
PA_MARKS = (b"Helix Boot:", b"Commander Rescue:")      # this one and the one from before the rename


def _png_chunk(kind: bytes, data: bytes) -> bytes:
    return struct.pack(">I", len(data)) + kind + data + struct.pack(">I", zlib.crc32(kind + data) & 0xFFFFFFFF)


def _png_encode(width: int, height: int, rgba: bytes) -> bytes:
    rows = b"".join(b"\0" + rgba[y * width * 4:(y + 1) * width * 4] for y in range(height))
    return (b"\x89PNG\r\n\x1a\n" + _png_chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 6, 0, 0, 0))
            + _png_chunk(b"IDAT", zlib.compress(rows, 9)) + _png_chunk(b"IEND", b""))


def _png_decode(png: bytes) -> tuple[int, int, bytearray] | None:
    """8-bit RGBA, non-interlaced PNG to (width, height, pixels); None for anything else."""
    i, idat, head = 8, b"", None
    while i + 8 <= len(png):
        n, kind = struct.unpack(">I4s", png[i:i + 8])
        if kind == b"IHDR":
            head = struct.unpack(">IIBBBBB", png[i + 8:i + 21])
        elif kind == b"IDAT":
            idat += png[i + 8:i + 8 + n]
        i += 12 + n
    if not head or head[2:5] != (8, 6, 0) or head[6] != 0:
        return None
    w, h = head[0], head[1]
    raw, stride, out = zlib.decompress(idat), w * 4, bytearray()
    prev = bytearray(stride)
    for y in range(h):
        ftype, line = raw[y * (stride + 1)], bytearray(raw[y * (stride + 1) + 1:(y + 1) * (stride + 1)])
        for x in range(stride):
            a = line[x - 4] if x >= 4 else 0
            b, c = prev[x], prev[x - 4] if x >= 4 else 0
            if ftype == 1:
                line[x] = (line[x] + a) & 255
            elif ftype == 2:
                line[x] = (line[x] + b) & 255
            elif ftype == 3:
                line[x] = (line[x] + (a + b) // 2) & 255
            elif ftype == 4:
                pa, pb, pc = abs(b - c), abs(a - c), abs(a + b - 2 * c)
                line[x] = (line[x] + (a if pa <= pb and pa <= pc else b if pb <= pc else c)) & 255
        out += line
        prev = line
    return w, h, out


def _pad_png(png: bytes, size: int) -> bytes | None:
    """png grown to exactly `size` bytes with a text chunk carrying PA_MARK, or None if too big."""
    text = b"Comment\0" + PA_MARK
    room = size - len(png) - 12                              # 12: a chunk's length, type and CRC
    if room < len(text):
        return None
    iend = len(png) - 12
    return png[:iend] + _png_chunk(b"tEXt", text + b" " * (room - len(text))) + png[iend:]


def _restyle_platform(exe: Path, backup: Path, recolor: dict | None = None) -> str:
    """Restyle the Platform's built-in images so themes look their own: the PortableApps.com
    logos it draws over the menu's bottom-right corner (imgPortableAppsLogo, and the white
    imgPortableAppsLogo2 for dark themes) become transparent, and each image named in
    `recolor` (e.g. imgLiveSearchIcon, the search box's magnifier) takes that colour, keeping
    its shape. They're PNGs in the main window's form data; each is rewritten at exactly its
    old byte length, so nothing else in the program moves. Returns 'patched', 'already' or
    why it couldn't."""
    if not exe.is_file():
        return "no Platform"
    orig = exe.read_bytes()
    slots: dict[str, tuple[int, int]] = {}
    for m in re.finditer(rb"\x06TImage[\x03-\x30]([A-Za-z0-9_]+)", orig):
        j = orig.find(b"\tTPngImage\x89PNG\r\n\x1a\n", m.end(), m.end() + 600)
        if j != -1:
            start = j + len(b"\tTPngImage")
            slots.setdefault(m.group(1).decode(), (start, orig.find(b"IEND", start) + 8))
    logos = [n for n in slots if re.fullmatch(r"imgPortableAppsLogo\d*", n)]
    if not logos:
        return "logo not found; the Platform has changed"
    wanted = {n: None for n in logos} | {n: c for n, c in (recolor or {}).items() if n in slots}
    data, changed = bytearray(orig), False
    for name, colour in wanted.items():
        start, stop = slots[name]
        now = bytes(data[start:stop])
        if colour is None:
            w, h = struct.unpack(">II", now[16:24])
            new = _pad_png(_png_encode(w, h, bytes(w * h * 4)), stop - start)
        else:
            img = _png_decode(now)
            if img is None:
                return f"{name} isn't a plain RGBA PNG"
            w, h, px = img
            r, g, b = (int(colour[i:i + 2], 16) for i in (0, 2, 4))
            for i in range(0, len(px), 4):
                px[i:i + 3] = bytes((r, g, b))
            new = _pad_png(_png_encode(w, h, bytes(px)), stop - start)
        if new is None:
            return f"{name} has no room for the change"
        if new != now:
            data[start:stop] = new
            changed = True
    missing = sorted(set(recolor or {}) - set(slots))
    if not changed:
        return "already"
    if not any(mark in orig for mark in PA_MARKS):           # keep the untouched original, not a patched one
        backup.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(exe, backup)
    with _temporary_output(exe) as staged:
        tmp = Path(staged.name)
        staged.write(bytes(data))
    shutil.copystat(exe, tmp)
    os.replace(tmp, exe)                                     # a running copy keeps the old file
    return "patched" + (f" (not found: {', '.join(missing)})" if missing else "")


def _validate_tree_patch(t: dict) -> None:
    if t.get("hide_logo") is not None:
        _safe_rel(t["hide_logo"], "tree executable")
    colours = t.get("recolor") or {}
    if not isinstance(colours, dict) or any(not isinstance(c, str) or not re.fullmatch(
            r"[0-9A-Fa-f]{6}", c) for c in colours.values()):
        raise RescueError("tree recolor must map image names to six-digit hex colours")


def _app_matches(base: Path, files: dict) -> bool:
    for rel, expected in files.items():
        p = _inside(base, rel, "app file")
        if not p.is_file() or file_hash(p) != expected:
            return False
    return True


def _tree_patches(t: dict, base: Path, dry_run: bool) -> None:
    rel = t.get("hide_logo")
    if not rel or dry_run:
        return
    _validate_tree_patch(t)
    _reject_links(base)
    exe = _inside(base, rel, "tree executable")
    result = _restyle_platform(exe, exe.parent / "Data" / (exe.name + ".original"), t.get("recolor"))
    if result.startswith("patched"):
        ok(f"{t['title']}: restyled (logo hidden{', icons recoloured' if t.get('recolor') else ''}; original kept in Data)"
           + result[len("patched"):])
    elif result not in ("already", "no Platform"):
        warn(f"{t['title']}: couldn't restyle it: {result}")


def _tree_files(src: Path) -> list[tuple[str, Path]]:
    return [(f.relative_to(src).as_posix(), f) for f in sorted(src.rglob("*")) if f.is_file()]


def _stick_extras(cfg: Config, placed: list[dict], apps: list[tuple]) -> list[tuple[str, Path | bytes]]:
    """The small files that go with the boot images: app launcher, theme, boot menu and
    `kind = "file"` tools such as Ventoy's wimboot plugin."""
    out: list[tuple[str, Path | bytes]] = []
    for c in cfg.categories.values():   # your own folders: a note in each, and a new stick has them too
        if c.get("user"):
            out.append((f"{cfg.iso_root}/{c['dir']}/HELIX-BOOT.txt", (
                f"{c['title']}: {c.get('description', '')}\r\n\r\n"
                "Put bootable images (.iso, .wim, .img, .vhd) here. The folder shows up in the\r\n"
                "boot menu as soon as it holds one; until then it stays hidden. Helix Boot never\r\n"
                "changes or removes anything in it except this note.\r\n").encode("utf-8")))
    lock = load_lock(cfg)
    for t in cfg.enabled(kinds={"file"}):
        entry = lock.get(t["name"])
        src = (Path(entry["path"]) if entry and entry.get("path")
               else cfg.cache / t["name"] / entry["final"] if entry else None)
        if src and src.is_file():
            out.append((t["dest"], src))
        elif src and src.is_dir():  # a local folder: its files go under dest, replacing older copies
            out += [(f"{t['dest']}/{f.relative_to(src).as_posix()}", f)
                    for f in sorted(src.rglob("*")) if f.is_file()]
        else:
            warn(f"{t['title']}: not fetched yet — run `helix fetch` (skipping)")
    # PE launcher index: "Title|relative\path\to.exe|description" per line (easy to parse from
    # cmd.exe, which reads the first two; the Lazarus launcher shows the description too)
    lines = [f"{t['title']}|{t['name']}\\{t.get('entry', '').replace('/', chr(92))}|"
             + " ".join(t.get("description", "").replace("|", "/").split())
             for t, _, _ in apps if t.get("entry")]
    out.append((f"{cfg.apps_root}/apps.txt", ("\r\n".join(lines) + "\r\n").encode("utf-8")))
    readme = _mac_readme(cfg, apps)
    if readme:
        out.append((f"{cfg.mac_root}/README.txt", readme))
    own = {rel.rpartition("/")[0] for rel, _ in out if rel.endswith(("/HelixBoot.exe", "/HelixBoot.sh"))}
    for folder in sorted(own):          # the apps on the stick itself: say what they are
        out.append((f"{folder}/README.txt", STICK_README.encode("utf-8")))
    launcher = cfg.assets / "pe" / "launcher"
    if launcher.is_dir():  # works from any WinPE, including Hiren's
        out += [(f"{cfg.apps_root}/{f.name}", f) for f in sorted(launcher.iterdir())
                if f.suffix.lower() in (".cmd", ".ps1")]
    lazarus = cfg.assets / "pe" / "lazarus"
    if lazarus.is_dir():  # the Lazarus launcher: Lazarus PE opens it at startup (Apps\LazarusStartup.cmd)
        out += [(f"{cfg.apps_root}/Lazarus/{f.name}", f) for f in sorted(lazarus.iterdir())
                if f.is_file() and f.suffix.lower() != ".md"]
    theme_src = cfg.assets / cfg.settings["theme"] if cfg.settings.get("theme") else None
    if theme_src and theme_src.is_dir():
        files: dict[str, Path | bytes] = {
            f.relative_to(theme_src).as_posix(): f for f in sorted(theme_src.rglob("*"))
            if f.is_file() and f.suffix not in (".py", ".pyc") and "__pycache__" not in f.parts}
        mine = cfg.repo / "byo" / "icons"      # your own icons win over the theme's and a preset's
        if mine.is_dir():
            files.update({f"mine/icons/{f.name}": f for f in sorted(mine.glob("*.png"))})
            big = [(f.name, *wh) for f in sorted(mine.glob("*.png")) if (wh := _png_size(f)) and max(wh) > 128]
            if big:   # GRUB decodes each icon at full size: big ones use up its memory, later ones vanish
                name, w, h = big[0]
                warn(f"{len(big)} of your icons in byo/icons/ are much bigger than the 40x40 Ventoy shows "
                     f"(e.g. {name}, {w}x{h}); at boot that can stop other icons appearing. "
                     "Shrink them with: theme/build-theme.py --fit-icons")
        packs = cfg.repo / "byo" / "icon-packs"           # your own icon packs, beside the theme's
        if packs.is_dir():
            files.update({f"icon-packs/{f.relative_to(packs).as_posix()}": f for f in sorted(packs.glob("*/*"))
                          if f.is_file() and f.suffix in (".png", ".toml")})
        if (cfg.repo / "byo" / "splash.png").is_file():   # your own picture before the menu
            files["mine/splash.png"] = cfg.repo / "byo" / "splash.png"
        splash = files.get("mine/splash.png") or files.get("splash.png")
        bar = SPLASH_BAR if "mine/splash.png" in files else _preset_meta(theme_src)["bar"]
        frames = _splash_frames(cfg, splash, bar) if splash else None
        if frames:   # its loading bar, ready-made: a PC without Pillow (a pack on Windows) still shows it
            files.update({f"splash/{f.name}": f for f in sorted(frames.glob("*.jpg"))})
            files["splash/for.txt"] = frames.name.encode()
        out += [(f"{THEME_SRC}/{rel}", f) for rel, f in files.items()]
    icons = _icons(cfg) if theme_src and theme_src.is_dir() else set()
    bare = [p["title"] for p in placed if icons and p["name"] not in icons]
    if bare:
        info(f"no menu icon for {', '.join(bare)}: `theme/build-theme.py --local` makes letter badges")
    # Ventoy reads UTF-8 but not \u escapes, so write non-ASCII (→, ü …) as is
    # the menu with every icon the stick could show; _apply_look keeps those its look has
    packs = _pack_icons(cfg) if icons else set()
    vjson = json.dumps(build_ventoy_json(cfg, placed, icons | packs), indent=2, ensure_ascii=False) + "\n"
    out.append((BASE_JSON, vjson.encode("utf-8")))
    return out


def _beside_vtoyefi(mnt: Path) -> bool:
    """Is mnt on a disk that also has Ventoy's own VTOYEFI partition? (Linux; elsewhere the
    caller checks, as the Windows app does.) That is a Ventoy stick whatever its name."""
    if os.name == "nt" or not shutil.which("lsblk") or not shutil.which("findmnt"):
        return False
    try:
        run = lambda *cmd: subprocess.run(cmd, capture_output=True, text=True, check=True).stdout   # noqa: E731
        src = run("findmnt", "-no", "SOURCE", "--target", str(mnt)).strip().split("[")[0]
        disk = run("lsblk", "-no", "PKNAME", src).split()
        return bool(disk) and "VTOYEFI" in run("lsblk", "-lno", "LABEL", f"/dev/{disk[0]}").split()
    except (OSError, subprocess.CalledProcessError):
        return False


def _open_stick(mnt: Path, init: bool, cfg: Config | None = None, *, migrate: bool = False) -> tuple[Path, dict]:
    """Check the target is a Ventoy stick (or one we've filled before); return its state."""
    if not mnt.is_dir():
        raise RescueError(f"{mnt} isn't a mounted folder. Plug the stick in and pass its mount point.")
    _reject_links(mnt)
    state_dir = mnt / STATE_DIR
    if not state_dir.exists() and (mnt / OLD_STATE_DIR).is_dir():
        if migrate:
            os.rename(mnt / OLD_STATE_DIR, state_dir)
        else:
            state_dir = mnt / OLD_STATE_DIR
    if not state_dir.exists():
        label = _label_of(mnt)
        names = {"Ventoy", STICK_LABEL} | ({cfg.stick_label} if cfg else set())
        if not init and label not in names and not _beside_vtoyefi(mnt):
            raise RescueError(
                f"{mnt} doesn't look like a Ventoy stick (label: {label or 'unknown'}). "
                "If you're sure, rerun with --init."
            )
    state_path = state_dir / "state.json"
    return state_dir, json.loads(state_path.read_text(encoding="utf-8")) if state_path.exists() else {}


def _stale_split(state: dict, stale: list[str], placed: dict[str, str | None], off: set[str], me: str,
                 everything: bool, versioned: set[str] = frozenset()) -> tuple[list[str], list[str]]:
    """Which of the images this project put on the stick, and this run doesn't want, to remove
    and which to keep. One goes when this run brought the same tool again (a newer version, or
    the same file in another folder), when its tool is switched off here, or when this PC put it
    there itself and no longer has it. The rest are another PC's (its own tools, or one whose
    download failed here): they stay, so updating from a second PC doesn't strip the stick.
    `placed` is this run's images, stick path to tool name; `me` this PC; `everything` removes all;
    `versioned` the placed paths whose file is a download named after its version."""
    if everything:
        return list(stale), []
    tools, names = state.get("tools") or {}, {n for n in placed.values() if n}
    by = state.get("by") or {}

    def shape(rel: str) -> tuple[str, str]:        # its folder, and its name but for the numbers
        folder, _, name = rel.rpartition("/")
        return folder, re.sub(r"\d+", "#", name)

    # A stick from before tools were recorded: a stale file is an older download of a tool placed
    # now when it sits in the same folder under the same name but for its numbers. Only for
    # downloads: your own files (windows10.iso, windows11.iso) are different tools, not versions.
    shapes = {shape(rel) for rel in versioned}
    remove, keep = [], []
    for rel in stale:
        name = tools.get(rel)
        if by.get(rel) == me:
            gone = True
        elif name is not None:
            gone = name in names or name in off
        else:
            gone = shape(rel) in shapes
        (remove if gone else keep).append(rel)
    return remove, keep


def _carry_menu(doc: dict, old: dict, kept: list[str]) -> dict:
    """Keep the boot-menu names, tips and icons of images that stay on the stick though this PC
    doesn't know their tools: taken from the menu as the stick had it."""
    images = {f"/{rel}" for rel in kept}
    dirs = {f"/{rel.rpartition('/')[0]}" for rel in kept}
    stems = {rel.rpartition("/")[2].rsplit(".", 1)[0] for rel in kept}

    def ours(e: dict) -> bool:
        return e.get("image") in images or e.get("dir") in dirs or ("key" in e and e["key"] in stems)

    def add(have: list, extra: list) -> list:
        seen = {json.dumps({k: v for k, v in e.items() if k in ("image", "dir", "key")}, sort_keys=True) for e in have}
        return have + [e for e in extra if isinstance(e, dict) and ours(e)
                       and json.dumps({k: v for k, v in e.items() if k in ("image", "dir", "key")}, sort_keys=True) not in seen]

    if isinstance(old.get("menu_alias"), list):
        doc["menu_alias"] = add(doc.get("menu_alias", []), old["menu_alias"])
    old_tip = old.get("menu_tip") if isinstance(old.get("menu_tip"), dict) else {}
    if isinstance(old_tip.get("tips"), list):
        tips = add((doc.get("menu_tip") or {}).get("tips", []), old_tip["tips"])
        if tips:            # this PC's tools may have no tips at all: then where they go comes over too
            doc.setdefault("menu_tip", {k: v for k, v in old_tip.items() if k != "tips"})["tips"] = tips
    if isinstance(old.get("menu_class"), list):
        classes = add(doc.get("menu_class", []), old["menu_class"])
        if classes:         # Ventoy takes the first key that matches: longest first, as build_ventoy_json has them
            doc["menu_class"] = ([c for c in classes if "key" not in c]
                                 + sorted((c for c in classes if "key" in c), key=lambda c: -len(c["key"])))
    return doc


def _carry_extras(mnt: Path, extras: list[tuple[str, Path | bytes]], kept: list[str], kept_apps: list[str],
                  apps_root: str) -> list[tuple[str, Path | bytes]]:
    """The menu and the launcher's app list, with what is kept from the stick added back in."""
    out = []
    for rel, data in extras:
        try:
            if rel == BASE_JSON and kept and isinstance(data, bytes):
                old = mnt / BASE_JSON if (mnt / BASE_JSON).is_file() else mnt / "ventoy" / "ventoy.json"
                doc = _carry_menu(json.loads(data), json.loads(old.read_text(encoding="utf-8")), kept)
                data = (json.dumps(doc, indent=2, ensure_ascii=False) + "\n").encode("utf-8")
            elif rel == f"{apps_root}/apps.txt" and kept_apps and isinstance(data, bytes):
                lines = [ln for ln in (mnt / rel).read_text(encoding="utf-8").splitlines()
                         if ln.split("|")[1:2] and ln.split("|")[1].split("\\")[0] in kept_apps]
                data += ("\r\n".join(lines) + "\r\n").encode("utf-8") if lines else b""
        except (OSError, ValueError):
            pass        # nothing readable to carry over: the tools still boot, under their file names
        out.append((rel, data))
    return out


def _put_by(state: dict, me: str, files: set[str], wrote: set[str], kept: list[str],
            apps: set[str], wrote_apps: set[str], kept_apps: list[str]) -> dict:
    """Which PC put each image and app on the stick: this one for what it just wrote, whoever
    it was before for what was already there or is being kept."""
    by, apps_by = state.get("by") or {}, state.get("apps_by") or {}
    return {
        "by": {**{rel: by[rel] for rel in kept if rel in by},
               **{rel: me if rel in wrote else by.get(rel, me) for rel in files}},
        "apps_by": {**{n: apps_by[n] for n in kept_apps if n in apps_by},
                    **{n: me if n in wrote_apps else apps_by.get(n, me) for n in apps}},
    }


# What a run is about to do to a stick, collected while it works it out, so a dry run can say
# it in one piece and the apps can ask first (update_plan).
_PLAN: list[tuple[str, str, int]] | None = None


def _planned(action: str, what: str, size: int = 0) -> None:
    """Note one thing this run does: action is copy, remove or keep."""
    if _PLAN is not None:
        _PLAN.append((action, what, size))


def plan_text(plan: list[tuple[str, str, int]]) -> str:
    """A plan in plain words: what an update copies, removes and leaves alone."""
    def names(action: str) -> list[str]:
        return [what for a, what, _ in plan if a == action]

    def listed(items: list[str]) -> str:
        return ", ".join(items[:8]) + (f" and {len(items) - 8} more" if len(items) > 8 else "")

    copy, remove, keep, move = names("copy"), names("remove"), names("keep"), names("move")
    if not copy and not remove and not move:
        lines = ["Everything on the stick is already up to date."]
    else:
        lines = []
        if copy:
            size = sum(n for a, _, n in plan if a == "copy")
            lines.append(f"Copy {len(copy)}" + (f" ({_fmt_bytes(size)})" if size else "") + f": {listed(copy)}")
        if move:
            lines.append(f"Move {len(move)} to its new folder: {listed(move)}")
        lines.append(f"Remove {len(remove)}: {listed(remove)}" if remove else "Remove nothing.")
    if keep:
        lines.append(f"Keep {len(keep)} this PC has no copy of: {listed(keep)}")
    return "\n".join(lines)


def update_plan(cfg: Config, target: str, pack: str | None = None, prune_unknown: bool = False,
                init: bool = False, verify: bool = False) -> list:
    """What `sync` (or `unpack`, given a pack) would do to the stick, without doing it or
    printing anything: a list of (copy | remove | keep, what, bytes) for plan_text."""
    global _PLAN
    args = argparse.Namespace(target=target, pack=pack, init=init, dry_run=True, verify=verify,
                              no_prune=False, prune_unknown=prune_unknown)
    _PLAN, streams = [], (sys.stdout, sys.stderr)
    try:
        with open(os.devnull, "w", encoding="utf-8") as quiet:
            sys.stdout = sys.stderr = quiet
            (cmd_unpack if pack else cmd_sync)(cfg, args)
        return _PLAN
    finally:
        (sys.stdout, sys.stderr), _PLAN = streams, None


def _keep_note(what: str, names: list[str]) -> None:
    for name in names:
        _planned("keep", name)
    if names:
        warn(f"keeping {len(names)} {what} this PC has no copy of: {', '.join(names)}. "
             "They stay on the stick as they are; --prune-unknown removes them.")


def _prune(mnt: Path, iso_root: str, stale: list[str], dry_run: bool) -> None:
    """Delete boot images this project put on the stick that are no longer wanted."""
    for rel in stale:
        p = (mnt / rel).resolve()
        if p.is_relative_to(mnt) and p.exists():
            info(f"removing old {rel}")
            _planned("remove", rel.rpartition("/")[2])
            if not dry_run:
                p.unlink()
    if not dry_run:  # category folders emptied by a rename or removal
        root = (mnt / iso_root).resolve()
        for d in sorted({(mnt / rel).parent for rel in stale}, key=lambda d: -len(d.parts)):
            if d.is_dir() and d.resolve() != root and d.resolve().is_relative_to(root) and not any(d.iterdir()):
                d.rmdir()


def _keep_edited_json(mnt: Path, state: dict) -> Path:
    """Back up a ventoy.json someone edited by hand, before it is rewritten; return its path."""
    vdir = mnt / "ventoy"
    vdir.mkdir(exist_ok=True)
    vjson = vdir / "ventoy.json"
    if vjson.exists() and state.get("ventoy_json_sha") != file_hash(vjson):
        backup = vdir / f"ventoy.json.bak-{dt.date.today().isoformat()}"
        shutil.copy2(vjson, backup)
        warn(f"your existing ventoy.json was backed up to ventoy/{backup.name}")
    return vjson


def _write_extras(cfg: Config, mnt: Path, state: dict, extras: list[tuple[str, Path | bytes]],
                  fresh_theme: bool) -> Path:
    """Write the launcher, theme and boot menu, keeping a copy of a ventoy.json someone edited.
    Only what differs is written: a refresh that changes nothing writes nothing here."""
    vjson = mnt / "ventoy" / "ventoy.json"
    changed = vjson.exists() and state.get("ventoy_json_sha") != file_hash(vjson)   # edited by hand: redo it
    _keep_edited_json(mnt, state)
    legacy = fresh_theme and any(rel.startswith("ventoy/theme/") for rel, _ in extras)
    if legacy:                      # a pack from before `helix theme`: its theme and menu are ready-made
        shutil.rmtree(mnt / THEME_SRC, ignore_errors=True)
        shutil.rmtree(mnt / "ventoy" / "theme", ignore_errors=True)
        (mnt / BASE_JSON).unlink(missing_ok=True)
    for rel, data in extras:
        dst = _inside(mnt, rel)
        dst.parent.mkdir(parents=True, exist_ok=True)
        try:
            if isinstance(data, bytes):
                if not (dst.is_file() and dst.stat().st_size == len(data) and dst.read_bytes() == data):
                    dst.write_bytes(data)
                    changed = True
            elif not _same_file(data, dst):
                shutil.copy2(data, dst)
                changed = True
        except PermissionError:
            if dst.name != APP_EXE:  # anything else that can't be written is a failed run, not a detail
                raise
            warn(f"{rel} is in use (it is the app doing this update), so it wasn't replaced: "
                 "it will be on the next update, or run Helix Boot from another folder")
    if fresh_theme and not legacy:
        changed |= _tidy_theme_source(cfg, mnt, state, {rel for rel, _ in extras})
    _apply_look(cfg, mnt, changed)
    return vjson


def _same_file(src: Path, dst: Path) -> bool:
    """Is dst already a copy of src? By size and time (copies keep the time; exFAT rounds it to
    2 s), which spares rewriting the big files on every refresh."""
    try:
        a, b = src.stat(), dst.stat()
    except OSError:
        return False
    return a.st_size == b.st_size and abs(a.st_mtime - b.st_mtime) <= 2


def _tidy_theme_source(cfg: Config, mnt: Path, state: dict, want: set[str]) -> bool:
    """After the theme on the stick was written: remove what this run didn't bring, in place.
    The stick's own icons and splash (from some PC's byo/) stay when this PC brings none and
    wasn't the one that put them there, so updating from a second PC doesn't swap them for the
    stock ones. Records in `state` whose each kind is; True when anything was removed."""
    me, src = cfg.pc_id(), mnt / THEME_SRC
    aside = mnt / STATE_DIR / "mine.keep"           # from 0.6.3/0.6.4, which moved them out of the way:
    if aside.is_dir():                              # a run cut short left them there. Put them back.
        for item in aside.iterdir():
            if not (src / "mine" / item.name).exists():
                (src / "mine").mkdir(parents=True, exist_ok=True)
                os.replace(item, src / "mine" / item.name)
        shutil.rmtree(aside, ignore_errors=True)
    by, keep = dict(state.get("mine_by") or {}), []
    for kind, sub in (("icons", "mine/icons"), ("splash", "mine/splash.png")):
        if any(rel.startswith(f"{THEME_SRC}/{sub}") for rel in want):
            by[kind] = me                           # this PC brings its own
        elif (src / sub).exists() and by.get(kind) != me:
            keep.append(f"{THEME_SRC}/{sub}")
            info(f"keeping the stick's own {kind}: this PC has none of its own")
        else:
            by.pop(kind, None)                      # this PC's own, which it no longer has
    state["mine_by"] = by
    removed = False
    for f in sorted(src.rglob("*"), reverse=True):  # a folder comes after what is in it
        rel = f.relative_to(mnt).as_posix()
        if f.is_dir():
            if not any(f.iterdir()):
                f.rmdir()
        elif rel not in want and not any(rel == k or rel.startswith(f"{k}/") for k in keep):
            f.unlink()
            removed = True
    return removed


# What `helix verify` checks apps against: each file's sha256, taken from the download or the
# pack it was copied from (never read back off the stick, where it may already be damaged).
def _zip_hashes(zf: zipfile.ZipFile, prefix: str = "") -> dict[str, str]:
    """sha256 of every file in a zip under prefix, named from there."""
    out = {}
    for m in zf.infolist():
        if m.is_dir() or not m.filename.startswith(prefix):
            continue
        h = hashlib.sha256()
        with zf.open(m) as f:
            while chunk := f.read(1 << 20):
                h.update(chunk)
        out[m.filename[len(prefix):]] = h.hexdigest()
    return out


def _load_hashes(mnt: Path) -> dict:
    try:
        data = json.loads((mnt / HASHES).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    apps = data.get("apps") if isinstance(data, dict) else None
    return {n: a for n, a in (apps or {}).items()
            if isinstance(a, dict) and isinstance(a.get("files"), dict) and isinstance(a.get("dir"), str)}


def _save_hashes(mnt: Path, hashes: dict, app_state: dict) -> None:
    """Keep the records of the apps still on the stick (another PC's too)."""
    text = json.dumps({"apps": {n: h for n, h in sorted(hashes.items()) if n in app_state}},
                      separators=(",", ":"), sort_keys=True) + "\n"
    path = mnt / HASHES
    if not (path.is_file() and path.read_text(encoding="utf-8") == text):
        path.parent.mkdir(exist_ok=True)
        path.write_text(text, encoding="utf-8")


def _damaged(state: dict) -> tuple[set[str], set[str]]:
    """The boot images and apps `helix verify` found damaged, which the next update copies again."""
    d = state.get("damaged") if isinstance(state.get("damaged"), dict) else {}
    return ({x for x in d.get("images") or [] if isinstance(x, str)},
            {x for x in d.get("apps") or [] if isinstance(x, str)})


def _still_damaged(state: dict, mnt: Path, fixed_images: set[str], fixed_apps: set[str], app_state: dict) -> dict:
    """What's left of that list after an update: what it couldn't copy again (another PC's)."""
    images, apps = _damaged(state)
    left = {"images": sorted(r for r in images - fixed_images if (mnt / r).is_file()),
            "apps": sorted(a for a in apps - fixed_apps if a in app_state)}
    return {"damaged": left} if left["images"] or left["apps"] else {}


def _finish(mnt: Path, state_dir: Path, files: set[str], app_state: dict, vjson: Path, extra: dict) -> None:
    tag = f"Helix Boot {__version__}\r\nsynced {dt.datetime.now():%Y-%m-%d %H:%M}\r\n"
    for name in (TAG_FILE, OLD_TAG_FILE):                    # the old name for older launchers and PEs
        (mnt / name).write_text(tag, encoding="utf-8")
    state_dir.mkdir(exist_ok=True)
    (state_dir / "state.json").write_text(json.dumps({
        "files": sorted(files), "apps": app_state, "ventoy_json_sha": file_hash(vjson),
        "synced": dt.datetime.now().isoformat(timespec="seconds"), "helix": __version__, **extra,
    }, indent=2) + "\n", encoding="utf-8")
    info("flushing writes to the stick…")
    _flush_volume(mnt)


def cmd_sync(cfg: Config, args) -> int:
    global _PLAN
    if args.dry_run and _PLAN is None:
        _PLAN = []                      # a dry run ends by saying what it would do, in one piece
    mnt = Path(args.target).expanduser().resolve()
    state_dir, state = _open_stick(mnt, args.init, cfg, migrate=not args.dry_run)
    placed, apps, missing = _plan(cfg, load_lock(cfg))
    want_files = {p["rel"] for p in placed}
    for m in missing:
        warn(f"{m}: not fetched yet — run `helix fetch` (skipping)")

    stale = [f for f in state.get("files", []) if f not in want_files]
    off = cfg.switched_off                 # switched off in this PC's local.toml: those go
    unknown = getattr(args, "prune_unknown", False)
    head(f"Syncing to {mnt}{'  (dry run)' if args.dry_run else ''}")

    # A file that only changed folder (e.g. a category was renamed) is moved, not copied again.
    moved_from = {Path(f).name: f for f in stale}
    # What each image on the stick was, by sha256. Size alone can't tell two builds apart:
    # ISOs round to whole sectors, so a rebuilt Lazarus PE is often exactly as big as the last.
    recorded = state.get("images", {})
    images: dict[str, str] = {}
    bad_images, bad_apps = _damaged(state)                  # found by `helix verify`: copied again
    me, wrote, wrote_apps = cfg.pc_id(), set(), set()      # what this PC puts on the stick in this run
    moved: set[str] = set()                                 # old paths of images that only change folder
    for n, p in enumerate(placed, 1):
        dst = _inside(mnt, p["rel"], "boot image path")
        old = moved_from.get(p["file"])
        if old and not dst.exists():
            src_old = (mnt / old).resolve()
            if src_old.is_relative_to(mnt) and src_old.is_file() \
                    and src_old.stat().st_size == p["src"].stat().st_size:
                info(f"{p['title']}: moving {old} → {p['rel']}")
                moved.add(old)
                _planned("move", p["title"])
                if not args.dry_run:
                    dst.parent.mkdir(parents=True, exist_ok=True)
                    os.replace(src_old, dst)
                    wrote.add(p["rel"])
                else:
                    continue

        same = dst.exists() and dst.stat().st_size == p["src"].stat().st_size
        if same and p["sha256"]:
            if args.verify:
                same = file_hash(dst) == p["sha256"]
            elif p["rel"] in recorded:
                same = recorded[p["rel"]] == p["sha256"]
            elif p["local"]:    # no record yet (an older stick): a local build may have been rebuilt
                same = file_hash(dst) == p["sha256"]
        if same and p["rel"] in bad_images and not args.verify:
            same = False
        if same:
            images[p["rel"]] = p["sha256"]
            ok(f"{p['title']} {p['version']} — already on stick")
            continue
        info(f"{p['title']} {p['version']} → {p['rel']}")
        _planned("copy", f"{p['title']} {p['version']}", p["src"].stat().st_size)
        if not args.dry_run:
            prog = Progress()
            prog.file(f"({n}/{len(placed)}) {p['file']}", p["src"].stat().st_size)
            _copy(p["src"], dst, prog)
            if args.verify and p["sha256"]:
                _uncached(dst)
                prog.file(f"({n}/{len(placed)}) verifying {p['file']}", dst.stat().st_size)
                good = file_hash(dst, progress=prog) == p["sha256"]
                prog.clear()
                if not good:
                    raise RescueError(f"{p['rel']} doesn't match after copying — the stick may be failing.")
            prog.clear()
            images[p["rel"]] = p["sha256"]
            wrote.add(p["rel"])
            ok(f"{p['title']} copied")

    app_state = dict(state.get("apps", {}))
    app_root = mnt / cfg.apps_root
    hashes = _load_hashes(mnt)
    for t, entry, src in apps:
        root = mnt / _app_root(cfg, t)
        dst = root / t["name"]
        unzip = zipfile.is_zipfile(src) and t.get("platform") != "mac"
        rec = hashes.get(t["name"])
        if args.verify or (not args.dry_run and not (rec and same_build(rec.get("version"), entry["version"]))):
            if unzip:
                with zipfile.ZipFile(src) as zf:
                    files = _zip_hashes(zf)
            else:
                files = {src.name: file_hash(src)}
            hashes[t["name"]] = {"version": entry["version"], "dir": f"{_app_root(cfg, t)}/{t['name']}",
                                 "files": files}
        if (same_build(app_state.get(t["name"]), entry["version"]) and dst.exists() and t["name"] not in bad_apps
                and (not args.verify or _app_matches(dst, hashes[t["name"]]["files"]))):
            ok(f"{t['title']} {entry['version']} — already on stick")
            continue
        info(f"{t['title']} {entry['version']} → {_app_root(cfg, t)}/{t['name']}/")
        _planned("copy", f"{t['title']} {entry['version']}", src.stat().st_size)
        if args.dry_run:
            continue
        new = root / f".{t['name']}.new"
        shutil.rmtree(new, ignore_errors=True)
        new.mkdir(parents=True)
        if unzip:
            with zipfile.ZipFile(src) as zf:
                zf.extractall(new, members=_safe_zip_members(zf))
        else:
            shutil.copy2(src, new / src.name)
        if dst.exists():
            shutil.rmtree(dst)
        os.replace(new, dst)
        if args.verify and not _app_matches(dst, hashes[t["name"]]["files"]):
            raise RescueError(f"{t['name']}: app files do not match after copying")
        app_state[t["name"]] = entry["version"]
        wrote_apps.add(t["name"])
        ok(f"{t['title']} {'unpacked' if unzip else 'copied'}")

    enabled_apps = {t["name"] for t, _, _ in apps}
    kept_apps = []
    for name in [n for n in app_state if n not in enabled_apps]:
        if not SAFE_NAME.fullmatch(name):   # state.json is on the stick: anything could have written it
            warn(f"ignoring an app name in the stick's state that isn't one: {name!r}")
            app_state.pop(name)
            continue
        if name not in off and not unknown and (state.get("apps_by") or {}).get(name) != me:
            kept_apps.append(name)          # another PC's: this one just has no copy of it
            continue
        info(f"removing app no longer in the manifest: {name}")
        _planned("remove", name)
        if not args.dry_run:
            for root in (app_root, mnt / cfg.mac_root):
                shutil.rmtree(_inside(root, name, "app folder"), ignore_errors=True)
            app_state.pop(name)

    remove, kept = _stale_split(state, stale, {p["rel"]: p["name"] for p in placed}, off, me, unknown,
                                versioned={p["rel"] for p in placed if not p["local"]})
    remove = [rel for rel in remove if rel not in moved]        # moved to its new folder, not removed
    kept = [rel for rel in kept if (mnt / rel).is_file() and rel not in moved]
    if args.no_prune:
        kept += [rel for rel in remove if (mnt / rel).is_file()]
    elif remove or moved:           # (the folders that moved images left empty go too)
        _prune(mnt, cfg.iso_root, remove + ([] if args.dry_run else sorted(moved)), args.dry_run)
    _keep_note("boot image(s)", [rel.rpartition("/")[2] for rel in kept] if not args.no_prune else [])
    _keep_note("app(s)", kept_apps)

    # Trees (the PortableApps.com Platform) go on once and then look after themselves:
    # never overwritten with an older copy, never pruned.
    for t, entry, src in _trees(cfg, load_lock(cfg)):
        base = mnt / t["dest"]
        if (base / t["once"]).exists():
            ok(f"{t['title']} — already on stick (it updates itself)")
            _tree_patches(t, base, args.dry_run)                # again after a self-update
            continue
        files = _tree_files(src)
        info(f"{t['title']} {entry['version']} → /{t['dest']}")
        _planned("copy", f"{t['title']} {entry['version']}")
        if args.dry_run:
            continue
        prog = Progress(sum(f.stat().st_size for _, f in files))
        prog.file(t["title"], 0)
        for rel, f in files:
            _copy(f, _inside(base, rel, "tree file"), prog)
        prog.clear()
        ok(f"{t['title']} installed")
        _tree_patches(t, base, args.dry_run)

    if args.dry_run:
        print(f"\n{plan_text(_PLAN or [])}\nDry run — nothing was written.")
        return 0

    app_root.mkdir(exist_ok=True)
    _save_hashes(mnt, hashes, app_state)
    theme_src = cfg.assets / cfg.settings["theme"] if cfg.settings.get("theme") else None
    extras = _carry_extras(mnt, _stick_extras(cfg, placed, apps), kept, kept_apps, cfg.apps_root)
    vjson = _write_extras(cfg, mnt, state, extras, fresh_theme=bool(theme_src and theme_src.is_dir()))
    images.update({rel: recorded[rel] for rel in kept if rel in recorded})
    tools = {**{rel: n for rel, n in (state.get("tools") or {}).items() if rel in kept},
             **{p["rel"]: p["name"] for p in placed}}
    _finish(mnt, state_dir, want_files | set(kept), app_state, vjson, {
        "images": images, "tools": tools, "mine_by": state.get("mine_by") or {},
        **_still_damaged(state, mnt, wrote | (want_files if args.verify else set()), wrote_apps, app_state),
        **_put_by(state, me, want_files, wrote, kept, {t["name"] for t, _, _ in apps}, wrote_apps, kept_apps)})
    ok(f"Stick is up to date: {len(placed)} boot image(s), {len(apps)} app(s).")
    return 0


# ── Packs: the whole stick in one file ────────────────────────────────────
# A pack is a zip holding the stick exactly as `sync` would lay it out (under stick/),
# Ventoy and this project's own installer (under installer/), and PACK_META, which lists
# every boot image with its sha256. `unpack` streams it onto a stick, so no downloads are
# needed, and the bundled installer means the zip is all another machine needs.
PACK_META = "helix-boot-pack.json"
OLD_PACK_META = "commander-rescue-pack.json"   # packs made before the rename
PACK_FORMAT = 1
BUNDLED = ["helix", "tools.toml", "install.sh", "refresh.sh", "theme.sh", "check.sh", "scripts/common.sh", "LICENSE"]
BUNDLED_MARK = "installer/.bundled"   # tells install.sh / refresh.sh to look for the pack beside them
APP_REPO = "Commanderx-code/helix-boot"   # where HelixBoot.exe is released
APP_EXE = "HelixBoot.exe"
BUNDLED_README = """Helix Boot pack
===============

Everything for a Helix Boot USB stick, including your own tools. Keep it private.

On Windows: unzip just installer\\HelixBoot.exe (if this pack has it; otherwise download
it from https://github.com/Commanderx-code/helix-boot/releases) next to this zip and run
it. It finds {zip} beside it, and Install / Update copy everything from it offline.

On any Linux PC with Python 3.11+, unzip just the installer (a few MB) next to this zip:

    unzip {zip} 'installer/*'         (or: bsdtar -xf {zip} installer)

New stick (ERASES it; you choose the stick and confirm):

    installer/install.sh

Update a stick already made with Helix Boot:

    installer/refresh.sh

Both find {zip} beside the installer folder and copy everything from it, with no
downloads. If the zip has been moved or renamed, add --from /path/to/the.zip.
"""


def _zip_file(zf: zipfile.ZipFile, src: Path, arc: str, compress: int = zipfile.ZIP_DEFLATED) -> str:
    """Add src to the zip as arc; return its sha256, taken from the bytes as they went in."""
    zi = zipfile.ZipInfo.from_file(src, arc, strict_timestamps=False)
    zi.compress_type = compress
    h = hashlib.sha256()
    with open(src, "rb") as s, zf.open(zi, "w", force_zip64=True) as d:
        while chunk := s.read(8 << 20):
            h.update(chunk)
            d.write(chunk)
    return h.hexdigest()


def cmd_pack(cfg: Config, args) -> int:
    lock = load_lock(cfg)
    placed, apps, missing = _plan(cfg, lock)
    for m in missing:
        warn(f"{m}: not fetched yet — run `helix fetch` (leaving it out of the pack)")
    if not placed:
        raise RescueError("nothing to pack yet — run `helix fetch` first")
    out = Path(args.output or f"helix-boot-{dt.date.today().isoformat()}.zip").expanduser().resolve()
    if out.suffix.lower() != ".zip":
        raise RescueError(f"{out.name}: a pack must end in .zip")

    vt = next((t for t in cfg.tools if t["kind"] == "ventoy"), None)
    ventry = lock.get(vt["name"]) if vt else None
    vsrc = cfg.cache / vt["name"] / ventry["source_file"] if ventry and ventry.get("source_file") else None
    if not vsrc or not vsrc.is_file():
        warn("Ventoy isn't fetched, so this pack can refresh a stick but not set up a new one "
             "(`helix fetch ventoy` fixes that)")
        vsrc = None

    # A pack also sets up sticks from Windows: Ventoy's Windows package and the Windows app go in too.
    win_ventoy = app_exe = None
    if vt and vt.get("windows") and not cfg.windows:
        wtool = {k: v for k, v in vt.items() if k != "windows"} | vt["windows"]
        win_ventoy = _pack_download(cfg, wtool | {"name": f"{vt['name']}-windows", "title": "Ventoy for Windows"}, lock)
        if not win_ventoy:
            warn("Ventoy for Windows isn't available, so this pack can't set up a new stick from Windows")
    app_exe = _pack_download(cfg, {"name": "helixboot-exe", "title": APP_EXE, "kind": "file", "source": "github",
                                   "repo": APP_REPO, "asset": [f"^{re.escape(APP_EXE)}$"],
                                   "checksum": ["github-digest"]}, lock)
    if not app_exe:
        warn(f"no released {APP_EXE} to include; on Windows, download it from "
             f"https://github.com/{APP_REPO}/releases and put it beside the pack")

    size = sum(p["src"].stat().st_size for p in placed) + sum(s.stat().st_size for _, _, s in apps)
    size += sum(x[0].stat().st_size for x in (win_ventoy, app_exe) if x) + (vsrc.stat().st_size if vsrc else 0)
    out.parent.mkdir(parents=True, exist_ok=True)
    free = shutil.disk_usage(out.parent).free
    if size > free:
        raise RescueError(f"the pack needs {_fmt_bytes(size)} but {out.parent} has {_fmt_bytes(free)} free")

    head(f"Packing {len(placed)} boot image(s) and {len(apps)} app(s) into {out} (~{_fmt_bytes(size)})")
    with _temporary_output(out) as staged:
        part = Path(staged.name)
    isos = []
    try:
        with zipfile.ZipFile(part, "w", allowZip64=True) as zf:
            for p in placed:
                info(f"{p['title']} {p['version']} ({_fmt_bytes(p['src'].stat().st_size)})")
                sha = _zip_file(zf, p["src"], f"stick/{p['rel']}", zipfile.ZIP_STORED)  # ISOs don't compress
                if p["sha256"] and sha != p["sha256"] and not p["local"]:
                    raise RescueError(f"{p['title']}: the cached {p['file']} has changed since it was verified. "
                                      f"Run `helix fetch --force {p['name']}`.")
                isos.append({"rel": p["rel"], "name": p["name"], "local": p["local"], "title": p["title"],
                             "version": p["version"], "sha256": sha,
                             "size": p["src"].stat().st_size})
            for t, entry, src in apps:
                base = f"stick/{_app_root(cfg, t)}/{t['name']}"
                if zipfile.is_zipfile(src) and t.get("platform") != "mac":  # unpacked now, exactly as `sync` would
                    with zipfile.ZipFile(src) as zs:
                        for m in _safe_zip_members(zs):
                            if m.is_dir():
                                continue
                            zi = zipfile.ZipInfo(f"{base}/{m.filename}", m.date_time)
                            zi.compress_type = zipfile.ZIP_DEFLATED
                            with zs.open(m) as s, zf.open(zi, "w", force_zip64=True) as d:
                                shutil.copyfileobj(s, d, 8 << 20)
                else:
                    _zip_file(zf, src, f"{base}/{src.name}")
            extras = _stick_extras(cfg, placed, apps)
            for rel, data in extras:
                if isinstance(data, bytes):
                    zf.writestr(f"stick/{rel}", data, zipfile.ZIP_DEFLATED)
                else:
                    _zip_file(zf, data, f"stick/{rel}")
            trees = []
            for t, entry, src in _trees(cfg, lock):
                for rel, f in _tree_files(src):
                    _zip_file(zf, f, f"once/{t['name']}/{rel}")
                trees.append({"name": t["name"], "title": t["title"], "dest": t["dest"], "once": t["once"],
                              "version": entry["version"], "hide_logo": t.get("hide_logo"),
                              "recolor": t.get("recolor")})
            if vsrc:
                _zip_file(zf, vsrc, f"installer/{vsrc.name}", zipfile.ZIP_STORED)
            if win_ventoy:
                _zip_file(zf, win_ventoy[0], f"installer/{win_ventoy[0].name}", zipfile.ZIP_STORED)
            if app_exe:
                _zip_file(zf, app_exe[0], f"installer/{APP_EXE}")
            for rel in BUNDLED:  # keeps their executable bits, so `unzip` gives runnable scripts
                f = (cfg.assets if rel == "tools.toml" else REPO) / rel
                if f.is_file():
                    _zip_file(zf, f, f"installer/{rel}")
            zf.writestr(BUNDLED_MARK, f"{__version__}\n", zipfile.ZIP_DEFLATED)
            zf.writestr("installer/README.txt", BUNDLED_README.format(zip=out.name), zipfile.ZIP_DEFLATED)
            zf.writestr(PACK_META, json.dumps({
                "format": PACK_FORMAT, "helix": __version__,
                "created": dt.datetime.now().isoformat(timespec="seconds"),
                "iso_root": cfg.iso_root, "apps_root": cfg.apps_root, "isos": isos,
                "apps": {t["name"]: e["version"] for t, e, _ in apps},
                "app_roots": {t["name"]: _app_root(cfg, t) for t, _, _ in apps if _app_root(cfg, t) != cfg.apps_root},
                # switched off by hand where the pack was made: unpack removes these from a stick that has them
                "off": sorted(cfg.switched_off),
                "ventoy": {"file": f"installer/{vsrc.name}", "version": ventry["version"]} if vsrc else None,
                "ventoy_windows": ({"file": f"installer/{win_ventoy[0].name}", "version": win_ventoy[1]["version"]}
                                   if win_ventoy else None),
                "app": {"file": f"installer/{APP_EXE}", "version": app_exe[1]["version"]} if app_exe else None,
                "trees": trees,
                "fresh_theme": any(rel.startswith(f"{THEME_SRC}/") for rel, _ in extras),
            }, indent=2), zipfile.ZIP_DEFLATED)
    except BaseException:
        part.unlink(missing_ok=True)
        raise
    os.replace(part, out)
    ok(f"Pack written: {out} ({_fmt_bytes(out.stat().st_size)})")
    info("It holds your own tools as well, so keep it somewhere private. To use it here:")
    info(f"  new stick:      ./install.sh --from {out}")
    info(f"  existing stick: ./refresh.sh --from {out}")
    info(f"On another PC it needs nothing else: unzip {out.name} 'installer/*', then installer/install.sh")
    if app_exe:
        info(f"On Windows: put installer\\{APP_EXE} beside the pack and run it.")
    return 0


def _pack_download(cfg: Config, tool: dict, lock: dict) -> tuple[Path, dict] | None:
    """Fetch (or reuse from the cache) a file only packs carry, such as Ventoy for Windows.
    Returns (file, lock entry), or None when it can't be had (offline and never fetched)."""
    try:
        fetch_tool(cfg, tool, lock)
        save_lock(cfg, lock)
    except (RescueError, OSError) as e:
        warn(f"{tool['title']}: couldn't check for a newer one ({e})")
    entry = lock.get(tool["name"])
    f = cfg.cache / tool["name"] / entry["source_file"] if entry and entry.get("source_file") else None
    return (f, entry) if f and f.is_file() else None


def _read_pack(zf: zipfile.ZipFile) -> dict:
    names = set(zf.namelist())
    meta_name = next((n for n in (PACK_META, OLD_PACK_META) if n in names), None)
    if not meta_name:
        raise RescueError(f"not a Helix Boot pack (no {PACK_META} inside)")
    meta = json.loads(zf.read(meta_name))
    if meta.get("format") != PACK_FORMAT:
        raise RescueError(f"this pack is format {meta.get('format')}; this helix reads format {PACK_FORMAT}. "
                          "Update Helix Boot.")
    _safe_zip_members(zf)
    for rel in ([meta[k] for k in ("iso_root", "apps_root") if k in meta] + [i["rel"] for i in meta["isos"]]
                + list(meta.get("app_roots", {}).values())
                + [t[k] for t in meta.get("trees", []) for k in ("dest", "once") if t[k]]):
        _safe_rel(rel, "path in pack")
    for key in ("ventoy", "ventoy_windows"):
        v = meta.get(key)
        if v is not None:
            if not isinstance(v, dict) or not isinstance(v.get("version"), str) or not re.fullmatch(
                    r"[A-Za-z0-9][A-Za-z0-9._-]{0,99}", v["version"]):
                raise RescueError(f"refusing unsafe {key} version in pack")
            _safe_rel(v.get("file"), "Ventoy archive in pack")
    for t in meta.get("trees", []):
        _validate_tree_patch(t)
    for name in list(meta["apps"]) + [t["name"] for t in meta.get("trees", [])]:
        if not isinstance(name, str) or not SAFE_NAME.fullmatch(name):
            raise RescueError(f"refusing unsafe name in pack: {name!r}")
    return meta


def _open_pack(path: str) -> zipfile.ZipFile:
    p = Path(path).expanduser()
    if not p.is_file():
        raise RescueError(f"can't find the pack {p}")
    try:
        return zipfile.ZipFile(p)
    except zipfile.BadZipFile:
        raise RescueError(f"{p.name} isn't a zip file (or it's incomplete)") from None


def _unzip_to(zf: zipfile.ZipFile, member: str, dst: Path, progress: Progress | None = None) -> str:
    """Stream one member to dst (via a .part file, fsynced); return its sha256."""
    staged = _temporary_output(dst)
    tmp = Path(staged.name)
    h = hashlib.sha256()
    try:
        with staged as d, zf.open(member) as s:  # zipfile checks the CRC as it reads
            since = 0
            while chunk := s.read(8 << 20):
                h.update(chunk)
                d.write(chunk)
                since += len(chunk)
                if since >= FLUSH_EVERY:
                    d.flush()
                    os.fsync(d.fileno())
                    since = 0
                if progress:
                    progress.add(len(chunk))
            d.flush()
            os.fsync(d.fileno())
    except zipfile.BadZipFile as e:
        tmp.unlink(missing_ok=True)
        raise RescueError(f"the pack is damaged ({member}: {e})") from None
    else:
        os.replace(tmp, dst)
    finally:
        tmp.unlink(missing_ok=True)
    return h.hexdigest()


def cmd_unpack(cfg: Config, args) -> int:
    global _PLAN
    if args.dry_run and _PLAN is None:
        _PLAN = []
    mnt = Path(args.target).expanduser().resolve()
    state_dir, state = _open_stick(mnt, args.init, cfg, migrate=not args.dry_run)
    with _open_pack(args.pack) as zf:
        meta = _read_pack(zf)
        names = set(zf.namelist())
        iso_root, apps_root = meta["iso_root"], meta["apps_root"]
        want_files = {i["rel"] for i in meta["isos"]}
        head(f"Unpacking {Path(args.pack).name} (made {meta['created'][:10]}) to {mnt}"
             f"{'  (dry run)' if args.dry_run else ''}")

        dests = {i["rel"]: _inside(mnt, i["rel"], "boot image path") for i in meta["isos"]}
        bad_images, bad_apps = _damaged(state)          # found by `helix verify`: copied again
        todo = [i for i in meta["isos"]
                if not (dests[i["rel"]].is_file() and dests[i["rel"]].stat().st_size == i["size"])
                or ((file_hash(dests[i["rel"]]) if args.verify or i["rel"] not in state.get("images", {})
                     else state["images"][i["rel"]]) != i["sha256"])
                or (i["rel"] in bad_images and not args.verify)]
        need = sum(i["size"] for i in todo)
        free = shutil.disk_usage(mnt).free
        if need > free and not args.dry_run:
            raise RescueError(f"the stick needs {_fmt_bytes(need)} free for this pack but has {_fmt_bytes(free)}")

        # Writing counts once; with --verify, reading each image back from the stick counts again.
        prog = Progress(need * (2 if args.verify else 1))
        for n, i in enumerate(meta["isos"], 1):
            if i not in todo:
                ok(f"{i['title']} {i['version']} — already on stick")
                continue
            info(f"{i['title']} {i['version']} → {i['rel']}")
            _planned("copy", f"{i['title']} {i['version']}", i["size"])
            if args.dry_run:
                continue
            if f"stick/{i['rel']}" not in names:
                raise RescueError(f"the pack is missing {i['rel']}")
            dst = dests[i["rel"]]
            name = Path(i["rel"]).name
            prog.file(f"({n}/{len(meta['isos'])}) {name}", i["size"])
            got = _unzip_to(zf, f"stick/{i['rel']}", dst, prog)
            if got != i["sha256"]:
                prog.clear()
                dst.unlink()
                raise RescueError(f"{i['title']}: the copy in the pack doesn't match its checksum. "
                                  "The pack is damaged; make a new one.")
            if args.verify:
                _uncached(dst)
                prog.file(f"({n}/{len(meta['isos'])}) verifying {name}", i["size"])
                good = file_hash(dst, progress=prog) == i["sha256"]
                if not good:
                    prog.clear()
                    raise RescueError(f"{i['rel']} doesn't match after copying — the stick may be failing.")
            prog.clear()
            ok(f"{i['title']} copied")

        app_state = dict(state.get("apps", {}))
        app_root = _inside(mnt, apps_root, "apps folder")
        roots = meta.get("app_roots", {})         # apps that go elsewhere than Apps: the Mac tools
        wrote_apps: set[str] = set()
        hashes = _load_hashes(mnt)
        for name, version in meta["apps"].items():
            root = _inside(mnt, roots.get(name, apps_root), "apps folder")
            dst = _inside(root, name, "app folder")
            prefix = f"stick/{roots.get(name, apps_root)}/{name}/"
            rec = hashes.get(name)
            fresh = not args.dry_run and not (rec and same_build(rec.get("version"), version))
            expected = _zip_hashes(zf, prefix) if args.verify else {}
            if (same_build(app_state.get(name), version) and dst.exists() and name not in bad_apps
                    and (not args.verify or _app_matches(dst, expected))):
                if fresh:
                    hashes[name] = {"version": version, "dir": f"{roots.get(name, apps_root)}/{name}",
                                    "files": _zip_hashes(zf, prefix)}
                ok(f"{name} {version} — already on stick")
                continue
            info(f"{name} {version} → {roots.get(name, apps_root)}/{name}/")
            _planned("copy", f"{name} {version}")
            if args.dry_run:
                continue
            new = root / f".{name}.new"
            shutil.rmtree(new, ignore_errors=True)
            files = {}
            for m in names:
                if m.startswith(prefix) and not m.endswith("/"):
                    files[m[len(prefix):]] = _unzip_to(zf, m, _inside(new, m[len(prefix):], "path in pack"))
            hashes[name] = {"version": version, "dir": f"{roots.get(name, apps_root)}/{name}", "files": files}
            if dst.exists():
                shutil.rmtree(dst)
            os.replace(new, dst)
            if args.verify and not _app_matches(dst, expected):
                raise RescueError(f"{name}: app files do not match after copying")
            app_state[name] = version
            wrote_apps.add(name)
            ok(f"{name} unpacked")
        unknown, kept_apps = getattr(args, "prune_unknown", False), []
        off = {n for n in meta.get("off", []) if isinstance(n, str)}
        me = cfg.pc_id()
        for name in [n for n in app_state if n not in meta["apps"]]:
            if not SAFE_NAME.fullmatch(name):   # state.json is on the stick: anything could have written it
                warn(f"ignoring an app name in the stick's state that isn't one: {name!r}")
                app_state.pop(name)
                continue
            if name not in off and not unknown and (state.get("apps_by") or {}).get(name) != me:
                kept_apps.append(name)      # another PC's: the pack just doesn't have it
                continue
            info(f"removing app that isn't in this pack: {name}")
            _planned("remove", name)
            if not args.dry_run:
                for root in {apps_root, cfg.mac_root, *roots.values()}:
                    shutil.rmtree(_inside(_inside(mnt, root, "apps folder"), name, "app folder"), ignore_errors=True)
                app_state.pop(name)

        stale = [f for f in state.get("files", []) if f not in want_files]
        remove, kept = _stale_split(state, stale, {i["rel"]: i.get("name") for i in meta["isos"]}, off, me, unknown,
                                    versioned={i["rel"] for i in meta["isos"] if i.get("local") is False})
        kept = [rel for rel in kept if _inside(mnt, rel, "path in the stick's state").is_file()]
        if args.no_prune:
            kept += [rel for rel in remove if (mnt / rel).is_file()]
        elif remove:
            _prune(mnt, iso_root, remove, args.dry_run)
        _keep_note("boot image(s)", [rel.rpartition("/")[2] for rel in kept] if not args.no_prune else [])
        _keep_note("app(s)", kept_apps)

        for t in meta.get("trees", []):
            base = _inside(mnt, t["dest"], "tree folder") if t["dest"] else mnt   # "" is the stick's root
            if _inside(base, t["once"], "tree marker").exists():
                ok(f"{t['title']} — already on stick (it updates itself)")
                _tree_patches(t, base, args.dry_run)
                continue
            info(f"{t['title']} {t['version']} → /{t['dest']}")
            if args.dry_run:
                continue
            prefix = f"once/{t['name']}/"
            for m in sorted(names):
                if m.startswith(prefix) and not m.endswith("/"):
                    _unzip_to(zf, m, _inside(base, m[len(prefix):], "path in pack"))
            ok(f"{t['title']} installed")
            _tree_patches(t, base, args.dry_run)

        if args.dry_run:
            print(f"\n{plan_text(_PLAN or [])}\nDry run — nothing was written.")
            return 0

        app_root.mkdir(exist_ok=True)
        _save_hashes(mnt, hashes, app_state)
        app_dirs = tuple(f"stick/{roots.get(n, apps_root)}/{n}/" for n in meta["apps"])
        extras = [(m[len("stick/"):], zf.read(m)) for m in sorted(names)
                  if m.startswith("stick/") and not m.endswith("/") and m[len("stick/"):] not in want_files
                  and not m.startswith(app_dirs)]
        extras = _carry_extras(mnt, extras, kept, kept_apps, apps_root)
        vjson = _write_extras(cfg, mnt, state, extras, fresh_theme=meta.get("fresh_theme", False))
    tools = {**{rel: n for rel, n in (state.get("tools") or {}).items() if rel in kept},
             **{i["rel"]: i["name"] for i in meta["isos"] if i.get("name")}}
    _finish(mnt, state_dir, want_files | set(kept), app_state, vjson, {
        "pack": meta["created"], "tools": tools, "mine_by": state.get("mine_by") or {},
        "images": {**{rel: sha for rel, sha in (state.get("images") or {}).items() if rel in kept},
                   **{i["rel"]: i["sha256"] for i in meta["isos"]}},
        **_still_damaged(state, mnt, {i["rel"] for i in todo} | (want_files if args.verify else set()),
                         wrote_apps, app_state),
        **_put_by(state, me, want_files, {i["rel"] for i in todo}, kept, set(meta["apps"]), wrote_apps, kept_apps)})
    ok(f"Stick is up to date from the pack: {len(meta['isos'])} boot image(s), {len(meta['apps'])} app(s).")
    return 0


# ── Ventoy's layout, written directly ─────────────────────────────────────
# Ventoy has an installer for Linux and for Windows, and none for macOS. What its installer
# writes for an MBR disk is simple enough to write without it (format_ventoy_disk_mbr and
# VentoyWorker.sh in its package): its boot code and core.img in the first MiB, the data
# partition from sector 2048, and its 32 MiB VTOYEFI image last, on a 4 KiB boundary. The
# image carries Secure Boot support as shipped. The boot test builds its disks with this, so
# what it returns is booted on UEFI and BIOS in every CI run.
VENTOY_EFI_SECTORS = 65536
VENTOY_DATA_START = 2048


def ventoy_layout(vdir: Path, sectors: int, data_type: int = 0x07) -> dict:
    """What to write on a disk of `sectors` 512-byte sectors to make it a Ventoy disk, from
    Ventoy's Linux package in vdir: "head" (the first 2048 sectors: boot code, partition table,
    core.img), "efi" (the VTOYEFI image) and "efi_start" (its sector). The data partition runs
    from sector 2048 to just before it, and is formatted by the caller (`data_type`: its type
    byte, 0x07 for exFAT). Each call gives the disk a new random id, as Ventoy does."""
    if sectors > 0xFFFFFFFF:
        raise RescueError("that disk is bigger than 2 TiB, which needs a GPT layout this can't write")
    if sectors < VENTOY_DATA_START + VENTOY_EFI_SECTORS + (64 << 20) // 512:
        raise RescueError("that disk is too small for Ventoy")
    try:
        boot = (vdir / "boot" / "boot.img").read_bytes()
        core = lzma.decompress((vdir / "boot" / "core.img.xz").read_bytes())
        efi = lzma.decompress((vdir / "ventoy" / "ventoy.disk.img.xz").read_bytes())
    except (OSError, lzma.LZMAError) as e:
        raise RescueError(f"{vdir} isn't Ventoy's Linux package, or it is damaged: {e}") from None
    if len(boot) < 446 or not 0 < len(core) <= (VENTOY_DATA_START - 1) * 512 or len(efi) != VENTOY_EFI_SECTORS * 512:
        raise RescueError(f"{vdir}: Ventoy's boot files aren't the sizes this knows how to write")
    data_end = sectors - VENTOY_EFI_SECTORS - 1
    data_end -= (data_end + 1) % 8                      # VTOYEFI starts on a 4 KiB boundary
    efi_start = data_end + 1

    def chs(lba: int) -> bytes:                         # as fdisk writes it: 255 heads, 63 sectors
        c, h, sec = lba // (255 * 63), (lba // 63) % 255, lba % 63 + 1
        return b"\xfe\xff\xff" if c > 1023 else bytes([h, sec | ((c >> 8) << 6), c & 0xFF])

    def entry(active: bool, kind: int, start: int, count: int) -> bytes:
        return struct.pack("<B3sB3sII", 0x80 if active else 0, chs(start), kind, chs(start + count - 1), start, count)

    head = bytearray(VENTOY_DATA_START * 512)
    head[:446] = boot[:446]
    head[384:400] = os.urandom(16)                      # Ventoy's id for the disk
    head[440:444] = os.urandom(4)                       # and the MBR's signature
    head[446:462] = entry(True, data_type, VENTOY_DATA_START, data_end - VENTOY_DATA_START + 1)
    head[462:478] = entry(False, 0xEF, efi_start, VENTOY_EFI_SECTORS)
    head[510:512] = b"\x55\xaa"
    head[512:512 + len(core)] = core
    return {"head": bytes(head), "efi": efi, "efi_start": efi_start, "data_start": VENTOY_DATA_START,
            "data_sectors": data_end - VENTOY_DATA_START + 1}


# ── Checking a stick ──────────────────────────────────────────────────────
# Cheap sticks go bad quietly. `verify` reads back everything this project put on a stick and
# compares it with what was put there: the boot images with the sha256s in state.json, the apps
# with hashes.json. It needs no cache or internet, so any PC can check any Helix Boot stick.
def check_stick(mnt: Path, hook=None) -> dict:
    """Read every boot image and app file back; return what's damaged, missing or unchecked.
    Damaged images and apps are noted on the stick, so the next update copies them again."""
    state_dir, state = _open_stick(mnt, init=True)
    if not state:
        raise RescueError(f"{mnt} has nothing from Helix Boot on it to check")
    images = {rel: sha for rel, sha in (state.get("images") or {}).items() if isinstance(sha, str)}
    apps = _load_hashes(mnt)
    todo = []                                       # (what, path, sha256, app or None)
    for rel, sha in sorted(images.items()):
        todo.append((rel, _inside(mnt, rel, "path in the stick's state"), sha, None))
    for name, rec in sorted(apps.items()):
        if name not in (state.get("apps") or {}):
            continue
        base = _inside(mnt, rec["dir"], "app folder")
        for rel, sha in sorted(rec["files"].items()):
            todo.append((f"{rec['dir']}/{rel}", _inside(base, rel, "app file"), sha, name))
    found = {"damaged": [], "missing": [], "changed": {}, "checked": 0,
             "unrecorded": sorted(n for n in (state.get("apps") or {}) if n not in apps),
             "images": len(images), "apps": len({a for *_, a in todo if a}), "menu": None}

    prog = Progress(sum(p.stat().st_size for _, p, _, _ in todo if p.is_file()), hook=hook)
    for what, path, sha, app in todo:
        if not path.is_file():
            found["missing"].append(what)
            continue
        prog.file(app or Path(what).name, path.stat().st_size)
        _uncached(path)                             # read the stick, not what the OS kept in memory
        good = file_hash(path, progress=prog) == sha
        found["checked"] += 1
        if good:
            continue
        if app:                                     # some tools save their settings in their folder
            found["changed"].setdefault(app, []).append(what)
        else:
            found["damaged"].append(what)
    prog.clear()
    try:
        json.loads((mnt / "ventoy" / "ventoy.json").read_text(encoding="utf-8"))
    except (OSError, ValueError) as e:
        found["menu"] = f"ventoy/ventoy.json can't be read ({e.__class__.__name__}): the boot menu won't work"

    # Noted for the next update. A missing file is noticed by any update anyway.
    bad = {"images": sorted(found["damaged"] + [m for m in found["missing"] if m in images]),
           "apps": sorted(set(found["changed"]) | {a for m in found["missing"] for a in [_app_of(m, apps)] if a})}
    if bad["images"] or bad["apps"] or "damaged" in state:
        state.pop("damaged", None)
        if bad["images"] or bad["apps"]:
            state["damaged"] = bad
        (state_dir / "state.json").write_text(json.dumps(state, indent=2) + "\n", encoding="utf-8")
        _flush_volume(mnt)
    return found


def _app_of(path: str, apps: dict) -> str | None:
    return next((n for n, rec in apps.items() if path.startswith(rec["dir"] + "/")), None)


def check_text(found: dict) -> str:
    """What `check_stick` found, in plain words."""
    lines = []
    if found["damaged"]:
        lines.append(f"✗ {len(found['damaged'])} boot image(s) are damaged: the stick may be failing.")
        lines += [f"    {Path(rel).name}" for rel in found["damaged"]]
    if found["missing"]:
        lines.append(f"✗ {len(found['missing'])} file(s) are missing:")
        lines += [f"    {rel}" for rel in found["missing"][:15]]
        if len(found["missing"]) > 15:
            lines.append(f"    … and {len(found['missing']) - 15} more")
    for app, files in sorted(found["changed"].items()):
        lines.append(f"! {app}: {len(files)} file(s) differ from when it was copied. Some tools save "
                     "their settings in their own folder; otherwise the stick may be failing.")
    if found["menu"]:
        lines.append(f"✗ {found['menu']}")
    if found["damaged"] or found["missing"] or found["changed"]:
        lines.append("  The next update copies those again (an app's saved settings go back to how they came). "
                     "If this keeps happening, replace the stick.")
    if not lines:
        lines.append(f"✓ Everything checks out: {found['images']} boot image(s) and {found['apps']} app(s), "
                     f"{found['checked']} file(s) read back.")
    if found["unrecorded"]:
        lines.append(f"• {len(found['unrecorded'])} app(s) were copied by an older Helix Boot and aren't "
                     "checked yet; the next update records them.")
    return "\n".join(lines)


def cmd_verify(cfg: Config, args) -> int:
    mnt = Path(args.target).expanduser().resolve()
    if not args.json:
        head(f"Checking {mnt} (reads the whole stick, so this takes a while)")
    found = check_stick(mnt)
    if args.json:
        print(json.dumps(found, indent=2))
    else:
        print(check_text(found))
    return 1 if found["damaged"] or found["missing"] or found["menu"] or found["changed"] else 0


def _ventoy_from_pack(cfg: Config, pack: str, windows: bool | None = None) -> Path:
    """Unpack the pack's Ventoy installer into the cache (once) and return its folder."""
    windows = os.name == "nt" if windows is None else windows
    tool = "Ventoy2Disk.exe" if windows else "Ventoy2Disk.sh"
    with _open_pack(pack) as zf:
        meta = _read_pack(zf)
        # Linux packs carry both packages; the Windows one is a .zip, the Linux one a .tar.gz.
        v = next((v for v in (meta.get("ventoy"), meta.get("ventoy_windows"))
                  if v and v["file"].endswith(".zip") == windows), None)
        if not v:
            if windows and meta.get("ventoy"):
                raise RescueError("this pack has Ventoy for Linux only. Make it again with this version of "
                                  "Helix Boot to set up sticks from Windows.")
            raise RescueError("this pack has no Ventoy installer. Make it again after `helix fetch ventoy`.")
        cfg.cache.mkdir(parents=True, exist_ok=True)
        cache_root = cfg.cache.resolve()
        dest = _inside(cache_root, f"ventoy-from-pack/{v['version']}-{'windows' if windows else 'linux'}",
                       "Ventoy cache folder")
        managed = cache_root / "ventoy-from-pack"
        if managed.exists() or managed.is_symlink():
            _reject_links(managed)
        tops = [d for d in dest.iterdir() if d.is_dir()] if dest.is_dir() else []
        if len(tops) == 1 and (tops[0] / tool).exists():
            return tops[0]
        shutil.rmtree(dest, ignore_errors=True)
        dest.mkdir(parents=True)
        archive = dest / Path(v["file"]).name
        _unzip_to(zf, v["file"], archive)
    if zipfile.is_zipfile(archive):
        with zipfile.ZipFile(archive) as z:
            z.extractall(dest, members=_safe_zip_members(z))
    else:
        with tarfile.open(archive) as tar:
            _safe_extract_tar(tar, dest)  # keeps the tools' executable bits
    archive.unlink()
    tops = [d for d in dest.iterdir() if d.is_dir()]
    if len(tops) != 1:
        raise RescueError(f"unexpected Ventoy archive layout in the pack: {sorted(d.name for d in tops)}")
    return tops[0]


SPLASH_BEGIN = "#### helix-boot splash: begin ####"
SPLASH_END = "#### helix-boot splash: end ####"
SPLASH_ANCHOR = "#clear all input key before show main menu\n"   # in Ventoy's grub.cfg, just before its menu


SPLASH_FRAMES = 20   # the loading bar's steps: ventoy/theme/splash/00.jpg (empty) … 20.jpg (full)


def _splash_block(seconds: int) -> str:
    # GRUB's only timer counts whole seconds, so the bar is paced by drawing: each frame takes
    # about 1/20 s to load and show, and is drawn `seconds` times. A slow PC just takes longer.
    frames = " ".join(f"{k:02d}" for k in range(SPLASH_FRAMES + 1)) + f" {SPLASH_FRAMES:02d}" * 2
    splash = ("# Its picture for a moment before the menu, with a loading bar when ventoy/theme/splash/\n"
              "# has the frames. ventoy/theme/splash.png on the stick; remove it and this does nothing.\n"
              'if [ "$vtoy_display_mode" != "CLI" -a -f "$vtoy_iso_part/ventoy/theme/splash.png" ]; then\n'
              '    set helix_splash="$vtoy_iso_part/ventoy/theme/splash"\n'
              f'    if [ -f "$helix_splash/{SPLASH_FRAMES:02d}.jpg" ]; then\n'
              f"        for f in {frames}; do\n"
              f"            for r in {' '.join(str(i + 1) for i in range(seconds))}; do\n"
              '                background_image -m stretch "$helix_splash/$f.jpg"\n'
              "                clear\n"
              "            done\n"
              "        done\n"
              "    else\n"
              '        background_image -m stretch "$vtoy_iso_part/ventoy/theme/splash.png"\n'
              "        clear\n"
              f"        sleep --interruptible {seconds}\n"
              "    fi\n"
              "    background_image\n"
              "    unset helix_splash\n"
              "fi\n") if seconds else ""
    return (f"{SPLASH_BEGIN}\n"
            "# Added by Helix Boot (helix splash).\n"
            f"# What the L and F1 keys do, when the stick's theme says so ({KEYS_CFG} there;\n"
            "# remove it and they are Ventoy's own again).\n"
            f'if [ -f "$vtoy_iso_part/{KEYS_CFG}" ]; then\n'
            f'    source "$vtoy_iso_part/{KEYS_CFG}"\n'
            "fi\n"
            f"{splash}"
            f"{SPLASH_END}\n\n")


SPLASH_BAR = ("#00dceb", "#b55eff")   # the loading bar, left to right, unless a preset names its own


def _rgb(color: str) -> tuple[int, int, int]:
    return tuple(int(color[i:i + 2], 16) for i in (1, 3, 5))


def _splash_frames(cfg: Config, splash: Path, bar: tuple[str, str] = SPLASH_BAR) -> Path | None:
    """The splash with a loading bar filling up across it, as JPEG frames for the boot script
    (GRUB draws a 1080p JPEG about three times as fast as a PNG): the folder holding them, named
    after the picture and the bar's colours. Made once and kept in the cache. Needs Pillow;
    without it (None) the splash shows as a still picture."""
    out = cfg.cache / "splash" / _splash_key(splash, bar)
    names = [f"{k:02d}.jpg" for k in range(SPLASH_FRAMES + 1)]
    if not all((out / n).is_file() for n in names):
        try:
            from PIL import Image, ImageDraw, ImageFilter
        except ImportError:
            info("no loading bar on the splash: that needs Pillow (python-pillow / pip install pillow)")
            return None
        try:
            with Image.open(splash) as im:
                base = im.convert("RGB").resize((1920, 1080), Image.Resampling.LANCZOS).convert("RGBA")
        except OSError as e:
            warn(f"couldn't read {splash.name} for the loading bar: {e}")
            return None
        bw, bh, x0, y0 = 560, 8, 680, 1000          # bottom centre, as on the theme's splash.png
        left, right = _rgb(bar[0]), _rgb(bar[1])
        track = Image.new("RGBA", base.size)
        ImageDraw.Draw(track).rounded_rectangle((x0 - 2, y0 - 2, x0 + bw + 1, y0 + bh + 1), radius=6,
                                                fill=(8, 6, 20, 200), outline=(186, 171, 211, 90))
        base = Image.alpha_composite(base, track)
        grad = Image.new("RGB", (bw, bh))
        gd = ImageDraw.Draw(grad)
        for x in range(bw):
            t = x / (bw - 1)
            gd.line((x, 0, x, bh), fill=tuple(round(c + (d - c) * t) for c, d in zip(left, right)))
        out.parent.mkdir(parents=True, exist_ok=True)
        tmp = Path(tempfile.mkdtemp(prefix=".splash-", dir=out.parent))
        for k, name in enumerate(names):
            img, fill = base, round(bw * k / SPLASH_FRAMES)
            if fill:
                glow = Image.new("RGBA", base.size)
                mask = Image.new("L", (fill, bh))
                ImageDraw.Draw(mask).rounded_rectangle((0, 0, fill - 1, bh - 1), radius=4, fill=255)
                glow.paste(grad.crop((0, 0, fill, bh)), (x0, y0), mask)
                img = Image.alpha_composite(Image.alpha_composite(img, glow.filter(ImageFilter.GaussianBlur(7))), glow)
            img.convert("RGB").save(tmp / name, quality=90, optimize=True)
        shutil.rmtree(out, ignore_errors=True)
        os.replace(tmp, out)
        kept = sorted((d for d in out.parent.iterdir() if d.is_dir()), key=lambda d: d.stat().st_mtime)
        for old in kept[:-8]:                       # frames for pictures no longer in use
            shutil.rmtree(old, ignore_errors=True)
    return out


def _splash_key(splash: Path, bar: tuple[str, str]) -> str:
    """Names a splash's frames: the picture, the bar's colours, and -1 for this bar's drawing."""
    return f"{file_hash(splash)[:16]}-{bar[0][1:]}{bar[1][1:]}-1"


# ── The stick's look ─────────────────────────────────────────────────────────
# Sync and unpack write the theme to .helix-boot/theme on the stick, as it is in the repo: the
# default, its presets (presets/<id>/), icon packs (icon-packs/<id>/) and your own pictures
# (mine/). ventoy/theme and ventoy/ventoy.json are built from that and the choice in look.json,
# so `helix theme` changes the look from any PC, and a refresh keeps it.

ICON_STYLES = ("grey",)       # ways the stick's icons can be redrawn (with Pillow); see _restyle_icons


def _restyle_icons(folder: Path, style: str) -> None:
    """Redraw every icon in a built theme's icons folder in a style. grey: shades of grey at
    full contrast, which turns a one-colour icon white. Without Pillow they stay as they are."""
    try:
        from PIL import Image
    except ImportError:
        info(f"the icons stay in colour: {style} icons need Pillow (python-pillow / pip install pillow)")
        return
    for f in sorted(folder.glob("*.png")):
        try:
            with Image.open(f) as im:
                im = im.convert("RGBA")
        except OSError:
            continue
        alpha = im.getchannel("A")
        grey = im.convert("RGB").convert("L")
        seen = [v for v, n in enumerate(grey.histogram(alpha.point(lambda a: 255 if a > 40 else 0))) if n]
        lo, hi = (seen[0], seen[-1]) if seen else (0, 255)
        if hi - lo < 40:        # one flat colour: its shape is the picture
            grey = grey.point(lambda v: 255)
        else:
            grey = grey.point(lambda v: 0 if v <= lo else 255 if v >= hi else round(255 * (v - lo) / (hi - lo)))
        Image.merge("RGBA", (grey, grey, grey, alpha)).save(f, optimize=True)


def _preset_meta(folder: Path) -> dict:
    """A theme folder's preset.toml: its title and the colours the menu and splash take from it."""
    meta = {"title": folder.name, "description": "", "muted": "#baabd3", "bar": SPLASH_BAR,
            "standalone": False, "plain": False, "icons": "", "tip": None, "version": None}
    try:
        got = tomllib.loads((folder / "preset.toml").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return meta
    colour = re.compile(r"#[0-9a-fA-F]{6}")
    for key in ("title", "description"):
        if isinstance(got.get(key), str):
            meta[key] = got[key]
    if isinstance(got.get("muted"), str) and colour.fullmatch(got["muted"]):
        meta["muted"] = got["muted"]
    bar = got.get("bar")
    if isinstance(bar, list) and len(bar) == 2 and all(isinstance(c, str) and colour.fullmatch(c) for c in bar):
        meta["bar"] = (bar[0], bar[1])
    meta["standalone"] = got.get("standalone") is True      # its own layout: the theme isn't laid under it
    meta["plain"] = got.get("plain") is True                # the plain choice, in place of Ventoy's own look
    if got.get("icons") in ICON_STYLES:                     # how its icons are drawn, unless a pack is picked
        meta["icons"] = got["icons"]
    for key in ("tip", "version"):                          # where the tip and Ventoy's version go: [left, top]
        at = got.get(key)
        if isinstance(at, list) and len(at) == 2 and all(isinstance(v, str) and re.fullmatch(r"\d{1,3}%", v) for v in at):
            meta[key] = (at[0], at[1])
    return meta


def _look(mnt: Path) -> dict:
    """The stick's chosen look; anything missing or unreadable falls back to the default."""
    look = dict(LOOK_DEFAULT)
    try:
        got = json.loads((mnt / LOOK_FILE).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return look
    known = {"background": ("theme", "custom"), "splash": ("auto", "theme", "custom", "off")}
    if isinstance(got, dict):   # the stick is anyone's to edit: a theme or pack by name, the rest from a list
        look.update({k: v for k, v in got.items() if k in look and isinstance(v, str) and SAFE_NAME.fullmatch(v)
                     and v in known.get(k, (v,))})
    return look


def _look_choices(mnt: Path) -> tuple[dict[str, dict], dict[str, dict]]:
    """The themes and icon packs this stick can switch between, by id."""
    src = mnt / THEME_SRC
    themes = {"default": _preset_meta(src)}
    themes["default"]["title"] += " (default)" if (src / "preset.toml").is_file() else ""
    for d in sorted((src / "presets").glob("*/")):
        if SAFE_NAME.fullmatch(d.name) and d.name not in ("default", "off") and (d / "theme.txt").is_file():
            themes[d.name] = _preset_meta(d)
    if not any(t["plain"] for t in themes.values()):   # a plain preset stands in for Ventoy's own look
        themes["off"] = {"title": "Off", "description": "Ventoy's own look: no theme, no icons.", "plain": False}
    packs = {"auto": {"title": "Automatic", "description": "The theme's own style: logos in colour, or grey where it asks for that."},
             "logos": {"title": "Logos", "description": "The tools' own logos in colour, and your icons from byo/icons/."},
             "grey": {"title": "Greyscale", "description": "The same icons in shades of grey."}}
    for d in sorted((src / "icon-packs").glob("*/")):
        if SAFE_NAME.fullmatch(d.name) and d.name not in packs and d.name != "off":
            try:
                got = tomllib.loads((d / "pack.toml").read_text(encoding="utf-8"))
            except (OSError, ValueError):
                got = {}
            packs[d.name] = {"title": str(got.get("title") or d.name), "description": str(got.get("description") or "")}
    packs["off"] = {"title": "Off", "description": "No icons: just the names."}
    return themes, packs


def _theme_id(themes: dict[str, dict], wanted: str) -> str:
    """The theme a name stands for: itself; `off` is the plain preset where the theme has one
    (so "no theme" is a quiet theme rather than Ventoy's white one); anything unknown, the default."""
    if wanted in themes:
        return wanted
    return next((k for k, t in themes.items() if t["plain"]), "default") if wanted == "off" else "default"


def _build_look(cfg: Config, mnt: Path, look: dict, new: Path, frames: bool = True) -> dict:
    """Build the theme folder for a look into `new` (emptied first), from the theme on the stick;
    return the boot menu (ventoy.json) that goes with it."""
    src = mnt / THEME_SRC
    doc = json.loads((mnt / BASE_JSON).read_text(encoding="utf-8"))
    themes, packs = _look_choices(mnt)
    theme = _theme_id(themes, look["theme"])
    themed = theme != "off" and (src / "theme.txt").is_file()
    preset = src / "presets" / theme if themed and theme != "default" else None
    meta = _preset_meta(preset or src)
    icons = look["icons"] if look["icons"] in packs else "auto"
    style = "grey" if icons == "grey" else meta["icons"] if icons == "auto" else ""
    pack = src / "icon-packs" / icons if icons not in ("auto", "logos", "grey", "off") else None
    shutil.rmtree(new, ignore_errors=True)
    new.mkdir(parents=True)

    def lay(folder: Path, dest: Path, skip: tuple[str, ...] = ()) -> None:
        for f in sorted(folder.rglob("*")):
            rel = f.relative_to(folder)
            if f.is_file() and rel.parts[0] not in skip:
                (dest / rel).parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(f, dest / rel)

    apart = ("presets", "icon-packs", "mine", "splash", "icons", "splash.png", "preset.toml", "pack.toml")
    if themed:
        for layer in (None if meta["standalone"] else src, preset):
            if layer:
                lay(layer, new, skip=apart)
        if look["background"] == "custom" and (mnt / LOOK_DIR / "background.png").is_file():
            shutil.copy2(mnt / LOOK_DIR / "background.png", new / _desktop_image(new))
        text = (new / "theme.txt").read_text(encoding="utf-8")
        if (mnt / KEYS_HOOK).is_file() and "key_lang.png" in text and (new / "key_power.png").is_file():
            text = text.replace("key_lang.png", "key_power.png").replace("key_help.png", "key_mem.png")
            (new / "theme.txt").write_text(text, encoding="utf-8")   # L: the power menu, F1: Memtest86+
        if icons == "off":      # no gap where the icons were
            text = (new / "theme.txt").read_text(encoding="utf-8")
            text = re.sub(r"^(\s*(?:icon_width|icon_height|item_icon_space)\s*=\s*)\d+", r"\g<1>0", text, flags=re.M)
            (new / "theme.txt").write_text(text, encoding="utf-8")
        else:                   # later layers win: the theme's, the preset's, your own, the pack's
            for layer in (src / "icons", preset / "icons" if preset else None, src / "mine" / "icons", pack):
                if layer and layer.is_dir():
                    lay(layer, new / "icons", skip=apart)
            if style and (new / "icons").is_dir():
                _restyle_icons(new / "icons", style)
    # the splash: your own (set on the stick, or byo/splash.png), else the theme's
    mine, custom = src / "mine" / "splash.png", mnt / LOOK_DIR / "splash.png"
    own = preset / "splash.png" if preset and (preset / "splash.png").is_file() else src / "splash.png"
    yours = custom if look["splash"] == "custom" and custom.is_file() else mine if mine.is_file() else None
    pick = None if look["splash"] == "off" else own if look["splash"] == "theme" else yours or own
    if pick and pick.is_file() and (themed or pick != own):   # no theme: no splash of its either
        shutil.copy2(pick, new / "splash.png")
        bar = meta["bar"] if pick == own else SPLASH_BAR
        key = _splash_key(pick, bar) if frames else ""
        ready = src / "splash" if frames else None
        if frames and not ((ready / "for.txt").is_file()
                           and (ready / "for.txt").read_text(encoding="utf-8").strip() == key):
            ready = _splash_frames(cfg, pick, bar)
        if ready:
            (new / "splash").mkdir()
            for f in sorted(ready.glob("*.jpg")):
                shutil.copy2(f, new / "splash" / f.name)
    if "theme" in doc and not themed:           # Ventoy's own look, and where its tips go there
        del doc["theme"]
        if "menu_tip" in doc:
            doc["menu_tip"].update(left="10%", top="80%", color="#7fb4ff")
    elif "theme" in doc:
        doc["theme"]["ventoy_color"] = meta["muted"]
        doc["theme"]["fonts"] = [f"/ventoy/theme/{f.relative_to(new).as_posix()}" for f in sorted(new.rglob("*.pf2"))]
        if meta["version"]:
            doc["theme"]["ventoy_left"], doc["theme"]["ventoy_top"] = meta["version"]
        if "menu_tip" in doc:
            doc["menu_tip"]["color"] = meta["muted"]
            if meta["tip"]:
                doc["menu_tip"]["left"], doc["menu_tip"]["top"] = meta["tip"]
    have = {f.stem for f in (new / "icons").glob("*.png")}
    if "menu_class" in doc:
        doc["menu_class"] = [c for c in doc["menu_class"] if c.get("class") in have]
        if not doc["menu_class"]:
            del doc["menu_class"]
    return doc


def _desktop_image(theme: Path) -> str:
    """The background's file name in a theme folder, from its theme.txt."""
    name = re.search(r'^desktop-image:\s*"([^"/\\]+)"', (theme / "theme.txt").read_text(encoding="utf-8"), re.M)
    return name.group(1) if name else "background.png"


# The hotkey row of the Helix themes shows an icon per key. Two of Ventoy's keys can do something
# more useful on a rescue stick than Language and Help: L opens a power menu, F1 starts
# Memtest86+. That takes a hook in Ventoy's boot script (`helix splash`; the Windows app does the
# same), so the icons and what the keys do follow KEYS_HOOK: without it, on a stick whose script
# couldn't be changed, the row shows Language and Help, as they are.
def set_keys_hook(mnt: Path, on: bool) -> bool:
    """Note on the stick whether its Ventoy has the hook. True if that changed."""
    marker = mnt / KEYS_HOOK
    if on == marker.is_file() or not (mnt / STATE_DIR).is_dir():
        return False
    if on:
        marker.write_text("Ventoy's boot script on this stick runs ventoy/helix-keys.cfg.\n", encoding="utf-8")
    else:
        marker.unlink()
    return True


def forget_keys_hook(cfg: Config, mnt: Path) -> None:
    """The hook is gone, or couldn't be put there: the menu's row shows Ventoy's own keys again."""
    _reject_links(mnt)
    if set_keys_hook(mnt, False):
        _apply_look(cfg, mnt)
        _flush_volume(mnt)


def _keys_cfg(mnt: Path) -> tuple[str, str]:
    """The two scripts Ventoy runs for the keys: KEYS_CFG and POWER_CFG."""
    try:
        doc = json.loads((mnt / BASE_JSON).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        doc = {}
    stems = [c["key"] for c in doc.get("menu_class", []) if c.get("class") == "memtest86plus" and "key" in c]
    image = next((a["image"] for a in doc.get("menu_alias", []) if "image" in a
                  and any(k in a["image"].rpartition("/")[2] for k in stems)
                  and not re.search(r'["$\\\n]', a["image"])), "")
    keys = ("# Written by Helix Boot with the theme: what the L and F1 keys do on this stick.\n"
            "function helix_power {\n"
            f"    configfile $vtoy_iso_part/{POWER_CFG}\n"
            "}\n"
            "function helix_memtest {\n"
            f'    if [ -n "{image}" -a -f "$vtoy_iso_part{image}" ]; then\n'
            '        if [ "$grub_platform" = "pc" ]; then\n'
            f'            legacy_iso_memdisk $vtoy_iso_part "{image}"\n'
            "        else\n"
            f'            uefi_iso_memdisk $vtoy_iso_part "{image}"\n'
            "        fi\n"
            "    else\n"
            '        echo "Memtest86+ is not on this stick."\n'
            "        sleep 3\n"
            "    fi\n"
            "}\n"
            'set VTOY_LANG_CMD="helix_power"\n'
            'set VTOY_HELP_CMD="helix_memtest"\n')
    power = ("# Written by Helix Boot with the theme: the menu the L key opens.\n"
             'menuentry "$VTLANG_POWER_REBOOT" --class=power-reboot {\n'
             "    echo -e '\\n\\nSystem is rebooting ... \\n'\n"
             "    sleep 1\n"
             "    reboot\n"
             "}\n"
             'menuentry "$VTLANG_POWER_HALT" --class=power-halt {\n'
             "    echo -e '\\n\\nSystem is halting ... \\n'\n"
             "    sleep 1\n"
             "    halt\n"
             "}\n"
             'if [ "$grub_platform" != "pc" ]; then\n'
             '    menuentry "$VTLANG_POWER_BOOT_EFIFW" --class=power-setup {\n'
             "        fwsetup\n"
             "    }\n"
             "fi\n"
             'menuentry "$VTLANG_RETURN_PREVIOUS" --class=vtoyret VTOY_RET {\n'
             '    echo "Return ..."\n'
             "}\n")
    return keys, power


def _apply_look(cfg: Config, mnt: Path, changed: bool = True) -> None:
    """Build ventoy/theme and ventoy/ventoy.json from the theme on the stick and its look.
    `changed` False: what they are built from is as it was, so only rebuild if the look, this
    version or Pillow's presence (greyscale icons, the loading bar) differ from last time."""
    if not (mnt / BASE_JSON).is_file():
        return                     # filled by an older Helix Boot or pack: the menu is as it was written
    out = mnt / "ventoy" / "theme"
    (mnt / "ventoy").mkdir(exist_ok=True)
    look = _look(mnt)
    stamp = {"look": look, "helix": __version__, "pillow": importlib.util.find_spec("PIL") is not None,
             "keys": (mnt / KEYS_HOOK).is_file()}
    built = mnt / STATE_DIR / "built.json"
    try:
        same = json.loads(built.read_text(encoding="utf-8")) == stamp
    except (OSError, ValueError):
        same = False
    if same and not changed and (mnt / "ventoy" / "ventoy.json").is_file() \
            and (out.is_dir() or not (mnt / THEME_SRC / "theme.txt").is_file() or look["theme"] == "off"):
        return
    new = out.with_name("theme.helix-new")
    doc = _build_look(cfg, mnt, look, new)
    if any(new.iterdir()) or (mnt / THEME_SRC / "theme.txt").is_file():
        shutil.rmtree(out, ignore_errors=True)
    if any(new.iterdir()):
        os.replace(new, out)
    else:                          # no theme on the stick, or it and the splash are off
        new.rmdir()
    (mnt / "ventoy" / "ventoy.json").write_text(json.dumps(doc, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    theme_txt = out / "theme.txt"       # the keys do what the row built into the theme shows
    rebound = theme_txt.is_file() and "key_power.png" in theme_txt.read_text(encoding="utf-8")
    for rel, text in zip((KEYS_CFG, POWER_CFG), _keys_cfg(mnt) if rebound else ("", "")):
        if rebound:
            (mnt / rel).write_text(text, encoding="utf-8")
        else:
            (mnt / rel).unlink(missing_ok=True)
    built.write_text(json.dumps(stamp) + "\n", encoding="utf-8")


def _own_picture(src: Path, dst: Path, dim: int = 0) -> None:
    """Your picture as the stick's background or splash: 1920x1080 (cropped to fill), optionally
    dimmed so the menu's text stays readable. Pillow does that; without it a PNG is taken as is."""
    dst.parent.mkdir(parents=True, exist_ok=True)
    try:
        from PIL import Image, ImageOps
    except ImportError:
        if dim or src.read_bytes()[:8] != b"\x89PNG\r\n\x1a\n":
            raise RescueError("resizing, dimming or converting a picture needs Pillow "
                              "(python-pillow / pip install pillow); a PNG can be used as it is") from None
        shutil.copy2(src, dst)
        return
    try:
        with Image.open(src) as im:
            img = ImageOps.fit(im.convert("RGB"), (1920, 1080), method=Image.Resampling.LANCZOS)
    except OSError as e:
        raise RescueError(f"{src} isn't a picture this can read: {e}") from None
    if dim:
        img = Image.blend(img, Image.new("RGB", img.size, (0, 0, 0)), dim / 100)
    with _temporary_output(dst) as staged:
        tmp = Path(staged.name)
        img.save(staged, format="PNG", optimize=True)
    os.replace(tmp, dst)


def look_report(mnt: Path, look: dict | None = None) -> dict:
    """A stick's look and what it can be changed to, for `helix theme --json` and the apps."""
    themes, packs = _look_choices(mnt)
    look = dict(look or _look(mnt))
    look["theme"] = _theme_id(themes, look["theme"])
    return {
        "look": look,
        "themes": [{"id": k, **{f: v[f] for f in ("title", "description")}} for k, v in themes.items()],
        "icon_packs": [{"id": k, **v} for k, v in packs.items()],
        "own_splash": (mnt / THEME_SRC / "mine" / "splash.png").is_file(),
        "custom": {w: (mnt / LOOK_DIR / f"{w}.png").is_file() for w in ("background", "splash")},
    }


def look_changes(mnt: Path, theme=None, icons=None, background=None, splash=None, dim: int = 0,
                 reset: bool = False) -> tuple[dict, dict[str, Path]]:
    """What the options ask for: the new look, and the pictures (background / splash) to take in."""
    if not (mnt / BASE_JSON).is_file():
        raise RescueError("this stick was filled by an older Helix Boot. Refresh it once with this "
                          "version (./refresh.sh), then choose its look.")
    themes, packs = _look_choices(mnt)
    look = dict(LOOK_DEFAULT if reset else _look(mnt))
    if theme:
        if theme not in themes and theme != "off":
            raise RescueError(f"no theme called {theme!r} on this stick. There are: {', '.join(themes)}")
        look["theme"] = _theme_id(themes, theme)
    if icons:
        if icons not in packs:
            raise RescueError(f"no icon pack called {icons!r} on this stick. There are: {', '.join(packs)}")
        look["icons"] = icons
    if not 0 <= dim <= 90:
        raise RescueError("--dim is a percentage from 0 to 90")
    pictures: dict[str, Path] = {}
    for what, value, kept in (("background", background, ("theme",)), ("splash", splash, ("auto", "theme", "off"))):
        if value in kept:
            look[what] = value
        elif value == "custom":         # the picture of yours already on the stick
            if not (mnt / LOOK_DIR / f"{what}.png").is_file():
                raise RescueError(f"--{what} custom: the stick has no {what} picture of yours yet; give a file")
            look[what] = "custom"
        elif value:
            picture = Path(value).expanduser()
            if not picture.is_file():
                raise RescueError(f"--{what}: {value} is neither a picture file nor one of: {', '.join(kept)}")
            pictures[what] = picture
            look[what] = "custom"
    if dim and "background" not in pictures:
        raise RescueError("--dim goes with --background PICTURE")
    return look, pictures


def set_look(cfg: Config, mnt: Path, look: dict, pictures: dict[str, Path] | None = None, dim: int = 0,
             force: bool = False) -> bool:
    """Put a look on the stick (False: it already has it). The choice is kept there."""
    pictures = pictures or {}
    state_dir, state = _open_stick(mnt, False, cfg, migrate=True)
    if look == _look(mnt) and not pictures and not force:
        return False
    for what, picture in pictures.items():
        _own_picture(picture, mnt / LOOK_DIR / f"{what}.png", dim if what == "background" else 0)
    vjson = _keep_edited_json(mnt, state)
    (mnt / STATE_DIR).mkdir(exist_ok=True)
    (mnt / LOOK_FILE).write_text(json.dumps(look, indent=2) + "\n", encoding="utf-8")
    _apply_look(cfg, mnt)
    if (state_dir / "state.json").is_file():       # the rewritten menu is ours, not a hand edit
        state["ventoy_json_sha"] = file_hash(vjson)
        (state_dir / "state.json").write_text(json.dumps(state, indent=2) + "\n", encoding="utf-8")
    _flush_volume(mnt)
    return True


# A saved look: one small zip with the choice and your own pictures and icons, to keep it safe
# or put it on another stick. Pictures only, checked before anything is written.
LOOK_SAVE = "helix-look.json"
LOOK_SAVE_FILES = re.compile(r"(look/(background|splash)|mine/splash|mine/icons/[A-Za-z0-9][A-Za-z0-9._-]{0,80})\.png")
LOOK_SAVE_MAX = 64 << 20             # a whole saved look; a picture is a few MB


def export_look(mnt: Path, out: Path) -> Path:
    """Save the stick's look to a zip."""
    if not (mnt / BASE_JSON).is_file():
        raise RescueError("this stick was filled by an older Helix Boot. Refresh it once with this version first.")
    files = [p for d in (mnt / LOOK_DIR, mnt / THEME_SRC / "mine") if d.is_dir() for p in sorted(d.rglob("*.png"))]
    out = out if out.suffix.lower() == ".zip" else out.with_name(out.name + ".zip")
    out.parent.mkdir(parents=True, exist_ok=True)
    with _temporary_output(out) as staged:
        tmp = Path(staged.name)
    with zipfile.ZipFile(tmp, "w", zipfile.ZIP_DEFLATED) as zf:
        zf.writestr(LOOK_SAVE, json.dumps({"format": 1, "look": _look(mnt), "helix": __version__,
                                           "saved": dt.date.today().isoformat()}, indent=2) + "\n")
        for p in files:
            base = mnt / LOOK_DIR if p.is_relative_to(mnt / LOOK_DIR) else mnt / THEME_SRC
            arc = ("look/" if base == mnt / LOOK_DIR else "") + p.relative_to(base).as_posix()
            if LOOK_SAVE_FILES.fullmatch(arc):
                zf.write(p, arc)
    os.replace(tmp, out)
    return out


def import_look(cfg: Config, mnt: Path, saved: Path) -> list[str]:
    """Put a saved look on the stick; return notes on what couldn't be used (a theme this stick lacks)."""
    if not (mnt / BASE_JSON).is_file():
        raise RescueError("this stick was filled by an older Helix Boot. Refresh it once with this version first.")
    try:
        zf = zipfile.ZipFile(saved)
    except (OSError, zipfile.BadZipFile):
        raise RescueError(f"{saved} isn't a saved Helix Boot look") from None
    with zf:
        try:
            meta = json.loads(zf.read(LOOK_SAVE))
        except (KeyError, ValueError):
            raise RescueError(f"{saved} isn't a saved Helix Boot look") from None
        members = [m for m in zf.infolist() if not m.is_dir() and m.filename != LOOK_SAVE]
        for m in members:
            if not LOOK_SAVE_FILES.fullmatch(m.filename):
                raise RescueError(f"{saved} holds something that isn't part of a look: {m.filename!r}")
        if sum(m.file_size for m in members) > LOOK_SAVE_MAX:
            raise RescueError(f"{saved} is too big to be a saved look")
        data = {m.filename: zf.read(m) for m in members}
    for name, blob in data.items():
        if not blob.startswith(b"\x89PNG\r\n\x1a\n"):
            raise RescueError(f"{saved}: {name} isn't a PNG picture")

    # The choice, as far as this stick has it: a theme or icon pack it lacks falls back to the default.
    got = meta.get("look") if isinstance(meta, dict) and isinstance(meta.get("look"), dict) else {}
    themes, packs = _look_choices(mnt)
    look, notes = dict(LOOK_DEFAULT), []
    for key, known in (("theme", set(themes) | {"off"}), ("icons", set(packs))):
        value = got.get(key)
        if isinstance(value, str) and value in known:
            look[key] = _theme_id(themes, value) if key == "theme" else value
        elif value:
            notes.append(f"this stick has no {key} {str(value)[:40]!r}: using the default")
    for key, known in (("background", ("theme", "custom")), ("splash", ("auto", "theme", "custom", "off"))):
        value = got.get(key)
        if value in known and (value != "custom" or f"look/{key}.png" in data):
            look[key] = value

    _open_stick(mnt, False, cfg, migrate=True)
    for d in (mnt / LOOK_DIR, mnt / THEME_SRC / "mine"):   # the saved look replaces your pictures and icons
        shutil.rmtree(d, ignore_errors=True)
    for name, blob in data.items():
        dst = mnt / (STATE_DIR + "/" + name if name.startswith("look/") else f"{THEME_SRC}/{name}")
        dst.parent.mkdir(parents=True, exist_ok=True)
        dst.write_bytes(blob)
    # Keep them on the next update unless that PC has icons or a splash of its own in byo/
    state_path = mnt / STATE_DIR / "state.json"
    state = json.loads(state_path.read_text(encoding="utf-8")) if state_path.is_file() else {}
    state["mine_by"] = {k: "saved look" for k, sub in (("icons", "mine/icons"), ("splash", "mine/splash.png"))
                        if (mnt / THEME_SRC / sub).exists()}
    state_path.write_text(json.dumps(state, indent=2) + "\n", encoding="utf-8")
    set_look(cfg, mnt, look, force=True)
    return notes


def look_preview(cfg: Config, mnt: Path, look: dict, out: Path, pictures: dict[str, Path] | None = None,
                 dim: int = 0, size: tuple[int, int] = (960, 540)) -> Path:
    """Draw how the boot menu would look with `look` (and a background picture not yet taken in),
    without touching the stick's menu. A close sketch from the real theme files, not a boot
    capture: Ventoy draws the real thing. Needs Pillow."""
    try:
        from PIL import Image, ImageDraw, ImageFont, ImageOps
    except ImportError:
        raise RescueError("a preview needs Pillow (python-pillow / pip install pillow)") from None
    W, H = 1920, 1080

    def font(px: int, bold: bool = False):
        for name in (("DejaVuSans-Bold.ttf", "segoeuib.ttf", "arialbd.ttf") if bold
                     else ("DejaVuSans.ttf", "segoeui.ttf", "arial.ttf")):
            try:
                return ImageFont.truetype(name, px)
            except OSError:
                continue
        try:
            return ImageFont.load_default(px)
        except TypeError:           # an older Pillow: its one small built-in font
            return ImageFont.load_default()

    work = cfg.cache / "look-preview"
    doc = _build_look(cfg, mnt, look, work, frames=False)
    rows = [a for a in doc.get("menu_alias", []) if "dir" in a] or doc.get("menu_alias", [])
    tips = (doc.get("menu_tip") or {}).get("tips") or []
    try:
        if "theme" not in doc:      # Ventoy's own look: light sky, grey box, plain text
            img = Image.new("RGB", (W, H), (236, 238, 242)).convert("RGBA")
            d = ImageDraw.Draw(img)
            d.text((W // 2, 150), "Ventoy", font=font(190, True), fill=(88, 166, 255), anchor="mm")
            d.rectangle((192, 440, 1728, 940), fill=(122, 126, 132))
            d.rectangle((250, 468, 1670, 500), fill=(84, 142, 196))
            for i, a in enumerate(rows[:14]):
                d.text((310, 484 + i * 30), a["alias"], font=font(22), fill=(232, 236, 240), anchor="lm")
            if tips:
                d.text((192, 864 + 90), tips[0]["tip"], font=font(20), fill=(127, 180, 255), anchor="lm")
            d.text((96, 1036), "1.1.x UEFI   www.ventoy.net   L:Language  F1:Help  F2:Browse  F3:TreeView",
                   font=font(20), fill=(60, 110, 200), anchor="lm")
        else:
            text = (work / "theme.txt").read_text(encoding="utf-8")

            def settings(block: str) -> dict:          # "#rrggbb" isn't a comment
                return {k: quoted or bare.strip() for k, quoted, bare in
                        re.findall(r'(\w+)\s*=\s*(?:"([^"\n]*)"|([^#\n}]*))', block)}

            def px(v: str, full: int) -> int:          # "5%", "40", "100%-70", "81%+24"
                m = re.fullmatch(r"\s*(?:(\d+(?:\.\d+)?)%)?\s*([+-]?\d+)?\s*", v)
                return round(float(m.group(1) or 0) * full / 100) + int(m.group(2) or 0) if m else 0

            def box(pattern: str, x: int, y: int, w: int, h: int) -> None:   # GRUB's nine-slice boxes
                prefix = pattern.split("*")[0]
                parts = {part: Image.open(f).convert("RGBA") for part in ("nw", "n", "ne", "w", "c", "e", "sw", "s", "se")
                         if (f := work / f"{prefix}{part}.png").is_file()}
                if not prefix or "c" not in parts or w <= 0 or h <= 0:
                    return
                (left, top) = parts["nw"].size if "nw" in parts else (0, 0)
                (right, bottom) = parts["se"].size if "se" in parts else (0, 0)
                xs, ys = (x, x + left, x + w - right), (y, y + top, y + h - bottom)
                ws, hs = (left, w - left - right, right), (top, h - top - bottom, bottom)
                for r, names in enumerate((("nw", "n", "ne"), ("w", "c", "e"), ("sw", "s", "se"))):
                    for c, part in enumerate(names):
                        if part in parts and ws[c] > 0 and hs[r] > 0:
                            img.alpha_composite(parts[part].resize((ws[c], hs[r])), (xs[c], ys[r]))

            menu = re.search(r"\+ boot_menu \{(.*?)\}", text, re.S)
            props = settings(menu.group(1) if menu else "")
            picture = (pictures or {}).get("background")
            with Image.open(picture or work / _desktop_image(work)) as im:
                img = ImageOps.fit(im.convert("RGB"), (W, H), method=Image.Resampling.LANCZOS)
            if picture and dim:
                img = Image.blend(img, Image.new("RGB", img.size, (0, 0, 0)), dim / 100)
            img = img.convert("RGBA")
            x, y = px(props.get("left", "5%"), W), px(props.get("top", "20%"), H)
            w, h = px(props.get("width", "49%"), W), px(props.get("height", "60%"), H)
            box(props.get("menu_pixmap_style", ""), x, y, w, h)
            pad, icon = px(props.get("item_padding", "0"), W), px(props.get("icon_width", "32"), W)
            gap, row_h = px(props.get("item_icon_space", "4"), W), px(props.get("item_height", "40"), H)
            step = row_h + px(props.get("item_spacing", "0"), H)
            size_of = lambda name: int(m.group(1)) if (m := re.search(r"(\d+)\s*$", props.get(name, ""))) else 18  # noqa: E731
            edge = 8 if props.get("menu_pixmap_style") else 0
            classes = {c["dir"]: c["class"] for c in doc.get("menu_class", []) if "dir" in c}
            d = ImageDraw.Draw(img)
            for i, a in enumerate(rows[:max(1, (h - 2 * edge) // step)]):
                ry = y + edge + i * step
                box(props.get("selected_item_pixmap_style" if i == 0 else "item_pixmap_style", ""),
                    x + edge, ry, w - 2 * edge - (16 if props.get("scrollbar") == "true" else 0), row_h)
                f = work / "icons" / f"{classes.get(a.get('dir'), '')}.png"
                if icon and f.is_file():
                    with Image.open(f) as im:
                        img.alpha_composite(im.convert("RGBA").resize((icon, icon), Image.Resampling.LANCZOS),
                                            (x + edge + pad, ry + (row_h - icon) // 2))
                d.text((x + edge + pad + (icon + gap if icon else 0), ry + row_h // 2), a["alias"],
                       font=font(size_of("selected_item_font" if i == 0 and "selected_item_font" in props else "item_font"),
                                 i == 0 and "Bold" in props.get("selected_item_font", "")),
                       fill=props.get("selected_item_color" if i == 0 else "item_color", "#ffffff"), anchor="lm")
            for block in re.findall(r"\+ image\s*\{(.*?)\}", text, re.S):          # e.g. Standby's power symbol
                at = settings(block)
                if (work / at.get("file", "")).is_file() and at.get("file"):
                    with Image.open(work / at["file"]) as im:
                        img.alpha_composite(im.convert("RGBA"), (px(at.get("left", "0"), W), px(at.get("top", "0"), H)))
            for block in text.split("+ hbox")[1:]:                                # Ventoy's hotkeys, the key hint
                at = settings(block.split("\n}\n")[0])                           # (this box only, not what follows it)
                shown = {"@VTOY_HOTKEY_TIP@": "L:Language  F1:Help  F2:Browse  F3:TreeView  F4:Localboot  F5:Tools  F6:ExMenu"
                         }.get(at.get("text", ""), "" if at.get("text", "@").startswith("@") else at["text"])
                if shown:
                    centred = at.get("align") == "center" and at.get("width", "").isdigit()
                    d.text((px(at.get("left", "0"), W) + (int(at["width"]) // 2 if centred else 0),
                            px(at.get("top", "0"), H) + 10), shown, font=font(16),
                           fill=at.get("color", "#ffffff"), anchor="mm" if centred else "lm")
            muted, tip = doc["theme"].get("ventoy_color", "#baabd3"), doc.get("menu_tip") or {}
            if tips:
                d.text((px(tip.get("left", "5%"), W), px(tip.get("top", "82%"), H) + 10), tips[0]["tip"], font=font(16),
                       fill=tip.get("color", muted), anchor="lm")
            d.text((px(doc["theme"].get("ventoy_left", "78%"), W), px(doc["theme"].get("ventoy_top", "94%"), H) + 10),
                   "1.1.x UEFI  www.ventoy.net", font=font(16), fill=muted, anchor="lm")
        out.parent.mkdir(parents=True, exist_ok=True)
        img.convert("RGB").resize(size, Image.Resampling.LANCZOS).save(out)
    except OSError as e:
        raise RescueError(f"couldn't draw the preview: {e}") from None
    finally:
        shutil.rmtree(work, ignore_errors=True)
    return out


def _print_look(mnt: Path, report: dict, numbered: bool = False) -> None:
    look = report["look"]
    themes = {t["id"]: t for t in report["themes"]}
    packs = {p["id"]: p for p in report["icon_packs"]}
    stock = look["theme"] == "off"       # Ventoy's own look has no icons or background of ours
    splash = {"auto": "your own (byo/splash.png)" if report["own_splash"] else "the theme's",
              "theme": "the theme's", "custom": "your picture", "off": "none"}[look["splash"]]
    head(f"The look of {mnt}")
    for n, (label, value) in enumerate((
            ("theme", themes.get(look["theme"], themes["default"])["title"]),
            ("icons", "none (no theme)" if stock else packs.get(look["icons"], packs["auto"])["title"]),
            ("background", "Ventoy's" if stock else "your picture" if look["background"] == "custom" else "the theme's"),
            ("splash", "none (no theme)" if stock and splash == "the theme's" else splash)), 1):
        print(f"  {str(n) + ')  ' if numbered else ''}{label:<11} {value}")


def _look_menu(cfg: Config, mnt: Path) -> int:
    """Change the look by picking from numbered lists, until done."""
    def ask(prompt: str) -> str:
        try:
            return input(f"  {prompt} ").strip()
        except EOFError:
            return "q"

    def choose(title: str, options: list[tuple[str, str]]) -> str | None:
        head(title)
        for n, (_, text) in enumerate(options, 1):
            print(f"  {n})  {text}")
        got = ask("Which one? (Enter: leave it)")
        return options[int(got) - 1][0] if got.isdigit() and 0 < int(got) <= len(options) else None

    def picture(what: str) -> str | None:
        got = ask(f"The picture to use as the {what} (a file's path; Enter: leave it):").strip("'\"")
        if got and not Path(got).expanduser().is_file():
            warn(f"{got} isn't a file")
            return None
        return got or None

    while True:
        report = look_report(mnt)
        _print_look(mnt, report, numbered=True)
        print("  p)  preview it        r)  back to the default look        q)  done")
        pick = ask("Change which?").lower()
        change: dict = {}
        if pick in ("q", ""):
            return 0
        if pick == "1":
            change["theme"] = choose("Themes", [(t["id"], f"{t['title']}" + (f": {t['description']}" if t["description"] else ""))
                                                for t in report["themes"]])
        elif pick == "2":
            change["icons"] = choose("Icon packs", [(p["id"], f"{p['title']}: {p['description']}") for p in report["icon_packs"]])
        elif pick == "3":
            got = choose("Background", [("theme", "The theme's"), ("picture", "Your own picture…")])
            change["background"] = picture("background") if got == "picture" else got
            if got == "picture" and change["background"]:
                dim = ask("Darken it by how much, 0-90 %? (Enter: 40, so the menu stays readable)") or "40"
                change["dim"] = int(dim) if dim.isdigit() else 40
        elif pick == "4":
            got = choose("Splash, the picture before the menu", [
                ("auto", "Yours from byo/splash.png, else the theme's"), ("theme", "The theme's"),
                ("picture", "Your own picture…"), ("off", "None")])
            change["splash"] = picture("splash") if got == "picture" else got
        elif pick == "r":
            change["reset"] = True
        elif pick == "p":
            try:
                shown = look_preview(cfg, mnt, report["look"], cfg.cache / "look-preview.png")
            except RescueError as e:
                warn(str(e))
                continue
            ok(f"Preview: {shown}")
            opener = shutil.which("xdg-open") or shutil.which("open")
            if hasattr(os, "startfile"):
                os.startfile(shown)  # noqa: S606
            elif opener:
                subprocess.Popen([opener, str(shown)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            continue
        change = {k: v for k, v in change.items() if v and (k != "dim" or change.get("background"))}
        if not change:
            continue
        try:
            look, pictures = look_changes(mnt, **change)
            if set_look(cfg, mnt, look, pictures, change.get("dim", 0)):
                ok("Look changed")
        except RescueError as e:
            warn(str(e))


def cmd_theme(cfg: Config, args) -> int:
    """Show or change a stick's look: a preset theme (or none), an icon pack (or none), your own
    background and splash. The choice is kept on the stick, so a refresh doesn't undo it."""
    mnt = Path(args.stick).expanduser().resolve()
    _open_stick(mnt, False, cfg)
    if getattr(args, "export", None):
        ok(f"Look saved to {export_look(mnt, Path(args.export).expanduser())}")
        return 0
    if getattr(args, "import_", None):
        for note in import_look(cfg, mnt, Path(args.import_).expanduser()):
            warn(note)
        ok(f"Look loaded onto {mnt}")
        _print_look(mnt, look_report(mnt))
        return 0
    look, pictures = look_changes(mnt, args.theme, args.icons, args.background, args.splash, args.dim, args.reset)
    if args.menu:
        return _look_menu(cfg, mnt)
    if args.preview:                    # a picture of it; the stick stays as it is
        shown = look_preview(cfg, mnt, look, Path(args.preview).expanduser(), pictures, args.dim)
        ok(f"Preview written: {shown}")
        return 0
    changed = set_look(cfg, mnt, look, pictures, args.dim)
    report = {**look_report(mnt, look), "changed": changed}
    if args.json:
        print(json.dumps(report, indent=2))
        return 0
    if changed:
        ok(f"Look changed on {mnt}")
    _print_look(mnt, report)
    head("Themes  (--theme ID)")
    for t in report["themes"]:
        print(f"  {t['id']:<11} {t['title']}" + (f": {t['description']}" if t["description"] else ""))
    head("Icon packs  (--icons ID)")
    for t in report["icon_packs"]:
        print(f"  {t['id']:<11} {t['title']}" + (f": {t['description']}" if t["description"] else ""))
    info("your own pictures: --background PICTURE [--dim 40], --splash PICTURE; --reset puts it all back")
    return 0


def cmd_splash(cfg: Config, args) -> int:
    """Show the theme's splash.png for a moment before the Ventoy menu, and let the stick's theme
    say what the L and F1 keys do. Ventoy has no setting for either, so this adds a few lines to
    its own boot script on the VTOYEFI partition (marked, and replaced or removed cleanly on the
    next run). A Ventoy install or upgrade rewrites that script; install.sh and refresh.sh run
    this afterwards. With --stick, the stick is told whether the keys' hook is there, so its
    menu shows what they really do."""
    efi = Path(args.efi).expanduser()
    _reject_links(efi)
    if getattr(args, "stick", None):
        _reject_links(Path(args.stick).expanduser())
    script = efi / "grub" / "grub.cfg"
    if not script.is_file():
        raise RescueError(f"{efi} isn't Ventoy's boot partition (VTOYEFI): it has no grub/grub.cfg")
    before = script.read_bytes().decode("utf-8")
    text = re.sub(rf"{re.escape(SPLASH_BEGIN)}.*?{re.escape(SPLASH_END)}\n\n?", "", before, flags=re.S)
    try:
        seconds = int(cfg.settings.get("splash_seconds", 1))
    except (TypeError, ValueError):
        raise RescueError("splash_seconds in local.toml must be a whole number of seconds") from None
    if not 0 <= seconds <= 10:
        raise RescueError("splash_seconds must be between 0 (no splash) and 10")
    wanted = bool(cfg.settings.get("theme")) and not args.remove
    known = text.count(SPLASH_ANCHOR) == 1
    if wanted and known:
        text = text.replace(SPLASH_ANCHOR, _splash_block(seconds) + SPLASH_ANCHOR)
    elif wanted:                             # a Ventoy this doesn't know: leave its boot script alone
        warn("this Ventoy's boot script isn't laid out as expected, so no splash was added")
    # The keys need what this Ventoy's script is known to have: its own way to start an ISO from memory
    keys = wanted and known and all(part in text for part in (
        "function legacy_iso_memdisk", "function uefi_iso_memdisk", "VTOY_LANG_CMD", "VTOY_HELP_CMD"))
    stick = Path(args.stick).expanduser() if getattr(args, "stick", None) else None

    def tell_stick() -> None:
        if stick and not args.dry_run and set_keys_hook(stick, keys):
            _apply_look(cfg, stick)          # the menu's hotkey row, to match
            _flush_volume(stick)
            ok("Keys: L opens the power menu, F1 starts Memtest86+" if keys else "Keys: Ventoy's own again")

    shown = f"{seconds} s before the menu" if seconds and wanted and known else "none"
    if text == before:
        ok(f"Splash: {'already ' if shown != 'none' else ''}{shown}")
        tell_stick()
        return 0
    if args.dry_run:
        info(f"would {'set the splash to ' + str(seconds) + ' s' if shown != 'none' else 'remove the splash'}")
        return 0
    with _temporary_output(script) as f:
        tmp = Path(f.name)
        # On the stick for good before it takes the script's place.
        f.write(text.encode("utf-8"))
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, script)
    ok(f"Splash: {seconds} s before the Ventoy menu" if shown != "none" else "Splash removed")
    tell_stick()
    return 0


def cmd_ventoy_path(cfg: Config, args) -> int:
    if getattr(args, "from_pack", None):
        print(_ventoy_from_pack(cfg, args.from_pack))
        return 0
    lock = load_lock(cfg)
    t = next((t for t in cfg.tools if t["kind"] == "ventoy"), None)
    entry = lock.get(t["name"]) if t else None
    path = cfg.cache / t["name"] / entry["final"] if entry else None
    if not path or not any((path / f).exists() for f in ("Ventoy2Disk.sh", "Ventoy2Disk.exe")):
        raise RescueError("Ventoy isn't fetched yet — run `helix fetch ventoy`")
    print(path)
    return 0


def main(argv: list[str] | None = None) -> int:
    for stream in (sys.stdout, sys.stderr):  # line-buffered keeps a shared log in order; errors=replace
        if hasattr(stream, "reconfigure"):     # keeps ✓/✗ from crashing a non-UTF-8 Windows console
            stream.reconfigure(line_buffering=True, errors="replace")
    ap = argparse.ArgumentParser(prog="helix", description="Build and refresh the Helix Boot USB.")
    ap.add_argument("--version", action="version", version=f"helix {__version__}")
    sub = ap.add_subparsers(dest="cmd", required=True, metavar="command")

    sub.add_parser("list", help="show every tool in the manifest").set_defaults(fn=cmd_list)

    p = sub.add_parser("check", help="compare cached versions with upstream (no downloads)")
    p.add_argument("tools", nargs="*")
    p.add_argument("--json", action="store_true", help="machine-readable output")
    p.set_defaults(fn=cmd_check)

    p = sub.add_parser("fetch", help="download and verify the latest releases")
    p.add_argument("tools", nargs="*", help="only these tools (default: all enabled)")
    p.add_argument("--force", action="store_true", help="re-download even if up to date")
    p.set_defaults(fn=cmd_fetch)

    p = sub.add_parser("sync", help="copy the cache onto a mounted Ventoy stick")
    p.add_argument("target", help="mount point of the Ventoy data partition")
    p.add_argument("--init", action="store_true", help="adopt a stick not labelled 'Ventoy'")
    p.add_argument("--dry-run", action="store_true", help="show what would change")
    p.add_argument("--verify", action="store_true", help="hash files on the stick (slow)")
    p.add_argument("--no-prune", action="store_true", help="keep old versions on the stick")
    p.add_argument("--prune-unknown", action="store_true",
                   help="also remove tools on the stick that this PC has no copy of (by default they stay)")
    p.set_defaults(fn=cmd_sync)

    p = sub.add_parser("pack", help="put the whole stick (and Ventoy) into one .zip for offline use")
    p.add_argument("output", nargs="?", help="where to write it (default: helix-boot-<date>.zip here)")
    p.set_defaults(fn=cmd_pack)

    p = sub.add_parser("unpack", help="fill a mounted Ventoy stick from a pack")
    p.add_argument("pack", help="the .zip made by `helix pack`")
    p.add_argument("target", help="mount point of the Ventoy data partition")
    p.add_argument("--init", action="store_true", help="adopt a stick not labelled 'Ventoy'")
    p.add_argument("--dry-run", action="store_true", help="show what would change")
    p.add_argument("--verify", action="store_true", help="hash files on the stick (slow)")
    p.add_argument("--no-prune", action="store_true", help="keep old versions on the stick")
    p.add_argument("--prune-unknown", action="store_true",
                   help="also remove tools on the stick that this PC has no copy of (by default they stay)")
    p.set_defaults(fn=cmd_unpack)

    p = sub.add_parser("verify", help="read a stick back and find damaged or missing files (no downloads)")
    p.add_argument("target", help="mount point of the Ventoy data partition")
    p.add_argument("--json", action="store_true", help="machine-readable output")
    p.set_defaults(fn=cmd_verify)

    p = sub.add_parser("splash",help="show the splash picture before the Ventoy menu (on its VTOYEFI partition)")
    p.add_argument("efi", help="mount point of the stick's VTOYEFI partition")
    p.add_argument("--remove", action="store_true", help="take the splash out again")
    p.add_argument("--dry-run", action="store_true", help="show what would change")
    p.add_argument("--stick", metavar="MOUNT", help="the stick's data partition: its menu then shows what the "
                                                    "L and F1 keys do (a power menu, Memtest86+)")
    p.set_defaults(fn=cmd_splash)

    p = sub.add_parser("theme", help="show or change a stick's look: theme, icons, background, splash")
    p.add_argument("stick", help="mount point of the Ventoy data partition")
    p.add_argument("--theme", metavar="ID", help="a preset theme, or `default`; `off` is the plain one (Standby)")
    p.add_argument("--icons", metavar="ID", help="`auto` (the theme's own style, the default), `logos`, `grey`, an icon pack, or `off`")
    p.add_argument("--background", metavar="PICTURE", help="your own background, or `theme` for the theme's")
    p.add_argument("--dim", type=int, default=0, metavar="PERCENT",
                   help="darken your background this much (0-90), so the menu stays readable")
    p.add_argument("--splash", metavar="PICTURE",
                   help="your own splash; `theme` for the theme's, `auto` (yours from byo/, else the theme's), `off`")
    p.add_argument("--reset", action="store_true", help="back to the default look")
    p.add_argument("--menu", action="store_true", help="choose from numbered lists instead")
    p.add_argument("--preview", metavar="FILE",
                   help="don't change the stick: write a picture of how the menu would look")
    p.add_argument("--json", action="store_true", help="print the look and the choices as JSON")
    p.add_argument("--export", metavar="ZIP", help="save the look (and your own pictures and icons) to a zip")
    p.add_argument("--import", dest="import_", metavar="ZIP", help="put a saved look on the stick")
    p.set_defaults(fn=cmd_theme)

    p = sub.add_parser("setting", help="print one of the [settings], for the scripts (e.g. stick_label)")
    p.add_argument("name", choices=["stick_label", "iso_root", "apps_root", "mac_root"])
    p.set_defaults(fn=lambda cfg, a: print(getattr(cfg, a.name)) or 0)

    p = sub.add_parser("ventoy-path", help="print the extracted Ventoy folder")
    p.add_argument("--from", dest="from_pack", metavar="PACK", help="use the Ventoy inside a pack")
    p.set_defaults(fn=cmd_ventoy_path)

    args = ap.parse_args(argv)
    try:
        # HELIX_USER_DIR: your local.toml and byo/ live there instead of beside helix (HelixBoot.sh)
        mine = _env("USER_DIR")
        return args.fn(Config(repo=Path(mine).expanduser().resolve(), assets=REPO) if mine else Config(), args)
    except RescueError as e:
        bad(str(e))
        return 1
    except KeyboardInterrupt:
        print()
        warn("interrupted — partial downloads are kept and will resume next time")
        return 130


if __name__ == "__main__":
    sys.exit(main())
